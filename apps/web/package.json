{
  "name": "@teya/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --port 3001",
    "build": "next build",
    "build:cloud": "pnpm db:migrate && pnpm exec tsx scripts/verify-cloud-billing.ts && pnpm exec tsx scripts/verify-cloud-chat.ts --model && pnpm build",
    "start": "next start --port 3001",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts",
    "test:e2e": "PLAYWRIGHT=True playwright test --workers=4",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node packages/database/src/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "workspace:check": "pnpm --recursive --if-present run check"
  },
