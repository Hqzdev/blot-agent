# Настройки процесса backend на машине владельца. Этот файл можно хранить в Git.
# Скопируйте в .env и заполните значения. Для личных Debug-сборок GigaChat включается в .app; SMTP остаётся на сервере.
# .env не шифрует секреты: не распространяйте его пользователям.
# Формат: ИМЯ=значение или ИМЯ="значение". Подстановки и команды не выполняются.
# Комментарии пишите отдельной строкой. Изменения применяются после перезапуска backend.

# SMTP для писем подтверждения и восстановления пароля.
# Заполните все четыре поля; порт 587 использует STARTTLS, 465 — TLS.
BLOT_SMTP_HOST=
BLOT_SMTP_PORT=587
BLOT_SMTP_USERNAME=
BLOT_SMTP_PASSWORD=
BLOT_SMTP_FROM=

# Authorization Key личного GigaChat API, без префикса Basic.
# Один общий ключ означает одну общую очередь генерации для всех аккаунтов этой установки.
BLOT_GIGACHAT_AUTH_KEY=
BLOT_GIGACHAT_MODEL=GigaChat-2
BLOT_GIGACHAT_CONTEXT_TOKENS=32768
BLOT_GIGACHAT_OUTPUT_TOKENS=4096
BLOT_RUN_TOKEN_BUDGET=1000000

# Абсолютный путь к PEM-файлу CA, выбранному и проверенному владельцем.
# Доверие применяется только к HTTP-клиенту GigaChat; системное хранилище не изменяется.
BLOT_GIGACHAT_CA_FILE=
BLOT_GIGACHAT_API_URL=https://api.giga.chat/v1/
BLOT_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# При необходимости задайте абсолютный каталог данных backend.
# BLOT_DATA_DIRECTORY=/absolute/path/to/blot-data

# Google OAuth для Gmail, Calendar и Drive. iOS использует iOS client, Mac — Desktop app.
# Формат client ID: NUMBER-ID.apps.googleusercontent.com. Токены остаются в Keychain.
# iPhone: yaroslavstrelkov.blot-agent.ios
BLOT_GOOGLE_IOS_CLIENT_ID=
# Mac: yaroslavstrelkov.blot-agent
BLOT_GOOGLE_MACOS_CLIENT_ID=
# Только конфигурация этого Desktop клиента, не Web OAuth secret.
# Укажите точный локальный путь к скачанному JSON; файл не коммитить.
BLOT_GOOGLE_MACOS_CLIENT_JSON=
# Альтернатива JSON для локальной приватной сборки:
BLOT_GOOGLE_MACOS_CLIENT_SECRET=

# Только сервис подтверждения почты/восстановления. Синхронизация идёт напрямую Wi-Fi/Bluetooth.
BLOT_ACCOUNT_SERVICE_URL=
# Vercel: PostgreSQL включает встроенный сервер аккаунтов; отдельный Java-хост не нужен.
# Подключите Neon через Storage в Vercel — DATABASE_URL добавляется автоматически.
DATABASE_URL=
# Optional server-only Vercel/Supabase connection; takes precedence over legacy URLs.
BLOT_POSTGRES_URL=
BLOT_WEB_SESSION_SECRET=
# Постоянный ключ кодов подтверждения dev-сервиса; scripts/run-cloud.sh создаёт локальный файл.
# BLOT_CLOUD_CHALLENGE_KEY_FILE=/absolute/path/to/challenge-key

# Google OAuth: общий вход в Blot через сайт (Web application).
# Client secret используется только сервером сайта.
# Redirect URI должен точно совпадать с адресом в Google Console.
BLOT_GOOGLE_WEB_CLIENT_ID=
BLOT_GOOGLE_WEB_CLIENT_SECRET=
BLOT_GOOGLE_WEB_REDIRECT_URI=

# Яндекс ID: общий вход в Blot через сайт со встроенным PostgreSQL-сервисом (DATABASE_URL).
# В Яндекс OAuth разрешите login:info и login:email. Client secret остаётся на сервере.
# Redirect URI должен точно совпадать с адресом в настройках приложения Яндекс.
BLOT_YANDEX_WEB_CLIENT_ID=
BLOT_YANDEX_WEB_CLIENT_SECRET=
BLOT_YANDEX_WEB_REDIRECT_URI=https://blot-agent.vercel.app/auth/yandex/callback

# Общая страница входа сайта; callback обменивается на сессию с PKCE.
BLOT_AUTH_URL=
# Public web URL allowed to receive Blot login codes (https://blot-agent.vercel.app/app).
# For local development use http://127.0.0.1:3001/app.
BLOT_WEB_APP_URL=

# Server-only web proxy configuration; never expose these as NEXT_PUBLIC variables.
BLOT_WEB_UPSTREAM_URL=
BLOT_WEB_PROXY_SECRET=

# Blot web billing (server-side, apps/web deployment). Test shop only.
YOOKASSA_SHOP_ID=1282645
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# Public native OAuth client IDs. Register the apps before setting these values.
# Slack: enable PKCE/public client; the native flow requests user scopes.
BLOT_SLACK_CLIENT_ID=
# Microsoft Entra: public desktop/mobile client, work/school accounts.
BLOT_TEAMS_CLIENT_ID=
# Optional published release metadata. Use a file with version, build, minimumOS,
# downloadURL (HTTPS), notes and publishedAt (ISO-8601). No release is advertised
# until the file is configured. Platform/channel combinations are independent.
# BLOT_RELEASE_MACOS_STABLE_JSON_FILE=/run/secrets/macos-stable-release.json
# BLOT_RELEASE_MACOS_BETA_JSON_FILE=/run/secrets/macos-beta-release.json
# BLOT_RELEASE_IOS_STABLE_JSON_FILE=/run/secrets/ios-stable-release.json
# BLOT_RELEASE_IOS_BETA_JSON_FILE=/run/secrets/ios-beta-release.json
