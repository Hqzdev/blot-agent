# Настройки процесса backend на машине владельца. Этот файл можно хранить в Git.
# Скопируйте в .env и заполните значения. Для личных Debug-сборок GigaChat включается в .app; SMTP остаётся на сервере.
# .env не шифрует секреты: не распространяйте его пользователям.
# Формат: ИМЯ=значение или ИМЯ="значение". Подстановки и команды не выполняются.
# Комментарии пишите отдельной строкой. Изменения применяются после перезапуска backend.

# SMTP для писем подтверждения и восстановления пароля.
# Заполните все четыре поля; порт 587 использует STARTTLS, 465 — TLS.
BLOT_SMTP_HOST=
BLOT_SMTP_PORT=587
BLOT_SMTP_USERNAME=
BLOT_SMTP_PASSWORD=
BLOT_SMTP_FROM=

# Authorization Key личного GigaChat API, без префикса Basic.
# Один общий ключ означает одну общую очередь генерации для всех аккаунтов этой установки.
BLOT_GIGACHAT_AUTH_KEY=
BLOT_GIGACHAT_MODEL=GigaChat-2
BLOT_GIGACHAT_CONTEXT_TOKENS=32768
BLOT_GIGACHAT_OUTPUT_TOKENS=4096
BLOT_RUN_TOKEN_BUDGET=1000000

# Абсолютный путь к PEM-файлу CA, выбранному и проверенному владельцем.
# Доверие применяется только к HTTP-клиенту GigaChat; системное хранилище не изменяется.
BLOT_GIGACHAT_CA_FILE=
BLOT_GIGACHAT_API_URL=https://api.giga.chat/v1/
BLOT_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# При необходимости задайте абсолютный каталог данных backend.
# BLOT_DATA_DIRECTORY=/absolute/path/to/blot-data

# Google OAuth для Gmail и Calendar. Зарегистрируйте два нативных client ID.
# Формат: NUMBER-ID.apps.googleusercontent.com. Client secret не нужен.
# Redirect URI вычисляется из client ID; Google-токены хранятся отдельно в Keychain.
# iPhone: yaroslavstrelkov.blot-agent.ios
BLOT_GOOGLE_IOS_CLIENT_ID=
# Mac: yaroslavstrelkov.blot-agent
BLOT_GOOGLE_MACOS_CLIENT_ID=

# Только сервис подтверждения почты/восстановления. Синхронизация идёт напрямую Wi-Fi/Bluetooth.
BLOT_ACCOUNT_SERVICE_URL=
# Vercel: PostgreSQL включает встроенный сервер аккаунтов; отдельный Java-хост не нужен.
# Подключите Neon через Storage в Vercel — DATABASE_URL добавляется автоматически.
DATABASE_URL=
BLOT_WEB_SESSION_SECRET=
# Постоянный ключ кодов подтверждения dev-сервиса; scripts/run-cloud.sh создаёт локальный файл.
# BLOT_CLOUD_CHALLENGE_KEY_FILE=/absolute/path/to/challenge-key

# Google OAuth: общий вход в Blot через сайт (Web application).
# Client secret используется только сервером сайта.
# Redirect URI должен точно совпадать с адресом в Google Console.
# Web flow требует реализации callback и передачи одноразового кода в приложение.
BLOT_GOOGLE_WEB_CLIENT_ID=
BLOT_GOOGLE_WEB_CLIENT_SECRET=
BLOT_GOOGLE_WEB_REDIRECT_URI=

# Общая страница входа сайта; callback обменивается на сессию с PKCE.
BLOT_AUTH_URL=
