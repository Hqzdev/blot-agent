                          "type": "text",
                          "id": "PAaZE",
                          "name": "Answer",
                          "fill": "$lp-fog",
                          "textGrowth": "fixed-width",
                          "width": 640,
                          "content": "Blot subscriptions come with weekly usage included, with additional usage billed based on token cost. Enterprise customers should contact sales.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Th1DR",
                      "name": "FAQ · Do Bots share one computer?",
                      "width": "fill_container",
                      "stroke": "#d5d9e2",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",
                      "gap": 16,
                      "padding": [
                        20,
                        0
                      ],
                      "children": [
                        {
                          "type": "frame",
                          "id": "RMtTB",
                          "name": "Question",
                          "width": "fill_container",
                          "gap": 16,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "adik1",
                              "name": "Question text",
                              "fill": "#0a0a0a",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Do Bots share one computer?",
                              "lineHeight": 1.5,
                              "fontFamily": "Inter",
                              "fontSize": 16,
                              "fontWeight": "500"
                            },
                            {
                              "type": "icon",
                              "id": "hFM4a",
                              "name": "Collapse",
                              "width": 16,
                              "height": 16,
                              "icon": "minus",
                              "library": "lucide",
                              "fill": "#858585"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "iUeEV",
                          "name": "Answer",
                          "fill": "#858585",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Yes. Every Blot shares one persistent cloud computer. Your Bots share that machine (files, browser, logins), so they can hand work off and keep context. Isolation is per user, not per Blot.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 16
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "jznMW",
                      "name": "FAQ · How does Blot handle my data & privacy?",
                      "width": "fill_container",
                      "stroke": "#d5d9e2",
                      "strokeWidth": {
                        "bottom": 1
                      },
                      "layout": "vertical",
                      "gap": 16,
                      "padding": [
                        20,
                        0
                      ],
                      "children": [
                        {
                          "type": "frame",
                          "id": "Dv7rK",
                          "name": "Question",
                          "width": "fill_container",
                          "gap": 16,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "text",
                              "id": "qPah3",
                              "name": "Question text",
                              "fill": "#0a0a0a",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "How does Blot handle my data & privacy?",
                              "lineHeight": 1.5,
                              "fontFamily": "Inter",
                              "fontSize": 16,
                              "fontWeight": "500"
                            },
                            {
                              "type": "icon",
                              "id": "PMpaF",
                              "name": "Collapse",
                              "width": 16,
                              "height": 16,
                              "icon": "minus",
                              "library": "lucide",
                              "fill": "#858585"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "yvEsl",
                          "name": "Answer",
                          "fill": "#858585",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Blot uses the same Blot SSO, auth, and privacy mode you already trust. Your cloud computer is encrypted in transit and at rest, with training opt-out. Sensitive actions can go through Auto Review before they run. Enterprise admins can set DLP, certs, proxies, and network controls at boot.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 16
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
