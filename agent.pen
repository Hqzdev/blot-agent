                              "name": "Text",
                              "fill": "$lp-ink",
                              "content": "How is Blot different from AI assistants?",
                              "fontFamily": "Inter",
                              "fontSize": 18,
                              "fontWeight": "500"
                            },
                            {
                              "type": "icon",
                              "id": "HTOs4",
                              "name": "Toggle",
                              "width": 18,
                              "height": 18,
                              "icon": "minus",
                              "library": "lucide",
                              "fill": "$lp-fog"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "Q98762",
                          "name": "Answer",
                          "fill": "$lp-fog",
                          "textGrowth": "fixed-width",
                          "width": 640,
                          "content": "Bots have their own computer, so they can work inside your apps and tools. They also run in parallel, 24/7, even when your laptop is closed.",
                          "lineHeight": 1.5,
                          "fontFamily": "Inter",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
