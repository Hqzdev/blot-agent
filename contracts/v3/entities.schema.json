{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blot.app/contracts/v3/entities.schema.json",
  "title": "Blot v3 public records",
  "$defs": {
    "DeviceKind": {
      "type": "string",
      "enum": [
        "DESKTOP",
        "PHONE"
      ]
    },
    "TrustState": {
      "type": "string",
      "enum": [
        "PENDING",
        "TRUSTED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "TaskState": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PLANNING",
        "WAITING_APPROVAL",
        "QUEUED",
        "RUNNING",
        "WAITING_USER",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELED",
        "INTERRUPTED"
      ]
    },
    "DeliveryState": {
      "type": "string",
      "enum": [
        "SAVED",
        "DELIVERED",
        "ACCEPTED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELED",
        "WAITING_CONNECTION",
        "INTERRUPTED"
      ]
    },
    "ActionState": {
      "type": "string",
      "enum": [
        "PREPARED",
        "WAITING_APPROVAL",
        "APPROVED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "DENIED",
        "EXPIRED",
        "UNKNOWN"
      ]
    },
    "AttemptState": {
      "type": "string",
      "enum": [
        "RUNNING",
        "SUBMITTED",
        "IN_REVIEW",
        "CHANGES_REQUESTED",
        "ACCEPTED",
        "FAILED",
        "CANCELED"
      ]
    },
    "AssignmentState": {
      "type": "string",
      "enum": [
        "ASSIGNED",
        "ACTIVE",
        "COMPLETED",
        "REPLACED",
        "CANCELED"
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "CREATED",
        "RUNNING",
        "WAITING_USER",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELED"
      ]
    },
    "AccessMode": {
      "type": "string",
      "enum": [
        "OBSERVE",
        "ASK_FIRST",
        "TRUSTED_SCOPE"
      ]
    },
    "GrantKind": {
      "type": "string",
      "enum": [
        "ONCE",
        "RULE"
      ]
    },
    "ConnectionState": {
      "type": "string",
      "enum": [
        "DISCONNECTED",
        "CONNECTING",
        "CONNECTED",
        "EXPIRED",
        "ERROR"
      ]
    },
    "AutomationKind": {
      "type": "string",
      "enum": [
        "REMINDER",
        "TASK"
      ]
    },
    "MissedRunPolicy": {
      "type": "string",
      "enum": [
        "COALESCE",
        "SKIP",
        "CATCH_UP"
      ]
    },
    "MemoryScope": {
      "type": "string",
      "enum": [
        "PERSONAL",
        "PROJECT",
        "AGENT"
      ]
    },
    "MemoryState": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "DELETED"
      ]
    },
    "BudgetState": {
      "type": "string",
      "enum": [
        "RESERVED",
        "SETTLED",
        "UNKNOWN"
      ]
    },
    "MessageRole": {
      "type": "string",
      "enum": [
        "USER",
        "ASSISTANT",
        "TOOL",
        "SYSTEM"
      ]
    },
    "PetState": {
      "type": "string",
      "enum": [
        "IDLE",
        "THINKING",
        "WORKING",
        "WAITING_USER",
        "PAUSED",
        "SUCCESS",
        "ERROR",
        "DISCONNECTED"
      ]
    },
    "ConversationKind": {
      "type": "string",
      "enum": [
        "DIRECT",
        "GROUP"
      ]
    },
    "ParticipantKind": {
      "type": "string",
      "enum": [
        "USER",
        "AGENT"
      ]
    },
    "ChangeOperation": {
      "type": "string",
      "enum": [
        "UPSERT",
        "DELETE"
      ]
    },
    "ReplicationState": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACKNOWLEDGED",
        "CONFLICT"
      ]
    },
    "LeaseState": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "RELEASED",
        "EXPIRED"
      ]
    },
    "AutomationTrigger": {
      "type": "string",
      "enum": [
        "SCHEDULED",
        "MANUAL"
      ]
    },
    "ExecutionMode": {
      "type": "string",
      "enum": [
        "LOCAL_OWNED",
        "DELEGATED"
      ]
    },
    "ModelStepState": {
      "type": "string",
      "enum": [
        "PREPARED",
        "RUNNING",
        "WAITING_TOOLS",
        "COMPLETED",
        "INTERRUPTED",
        "CANCELED",
        "FAILED"
      ]
    },
    "RecordMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ownerId",
        "workspaceId",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ExecutionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executorDeviceId",
        "originDeviceId",
        "taskId",
        "revision",
        "leaseGeneration"
      ],
      "properties": {
        "executorDeviceId": {
          "type": "string",
          "format": "uuid"
        },
        "originDeviceId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "leaseGeneration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "email",
        "name",
        "emailVerified"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "email": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "emailVerified": {
          "type": "boolean"
        }
      }
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "name",
        "kind",
        "platform",
        "publicKey",
        "lastSeenAt",
        "revoked"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DeviceKind"
        },
        "platform": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        },
        "lastSeenAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "TrustedPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "desktopDeviceId",
        "phoneDeviceId",
        "verificationCode",
        "expiresAt",
        "state"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "desktopDeviceId": {
          "type": "string",
          "format": "uuid"
        },
        "phoneDeviceId": {
          "type": "string",
          "format": "uuid"
        },
        "verificationCode": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "$ref": "#/$defs/TrustState"
        }
      }
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "name",
        "executorDeviceId",
        "accessMode",
        "folderIds"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "name": {
          "type": "string"
        },
        "executorDeviceId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessMode": {
          "$ref": "#/$defs/AccessMode"
        },
        "folderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "name",
        "repositoryPath"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "name": {
          "type": "string"
        },
        "repositoryPath": {
          "type": "string"
        }
      }
    },
    "AgentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "name",
        "roleId",
        "avatarShape",
        "avatarColor",
        "instructions",
        "modelId",
        "accessMode",
        "configurationId"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "name": {
          "type": "string"
        },
        "roleId": {
          "type": "string"
        },
        "avatarShape": {
          "type": "string"
        },
        "avatarColor": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "accessMode": {
          "$ref": "#/$defs/AccessMode"
        },
        "configurationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentConfigurationRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "agentId",
        "revision",
        "instructions",
        "toolIds",
        "modelId"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "agentId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "instructions": {
          "type": "string"
        },
        "toolIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelId": {
          "type": "string"
        }
      }
    },
    "Conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "agentId",
        "title",
        "mobileOwned",
        "pinned",
        "archived",
        "kind"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "agentId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "mobileOwned": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversationKind"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "conversationId",
        "role",
        "content",
        "delivery",
        "commandId",
        "artifactIds",
        "authorAgentId",
        "replyToMessageId",
        "mentions",
        "position",
        "executorDeviceId"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "content": {
          "type": "string"
        },
        "delivery": {
          "$ref": "#/$defs/DeliveryState"
        },
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "authorAgentId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "replyToMessageId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "mentions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MessageMention"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "executorDeviceId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "projectId",
        "conversationId",
        "goal",
        "state",
        "plan",
        "configurationId",
        "parentTaskId",
        "skillRevisionId",
        "budgetTokenLimit",
        "executionMode"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "goal": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "configurationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "parentTaskId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "skillRevisionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "budgetTokenLimit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "executionMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TaskAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "stepId",
        "agentId",
        "state",
        "criteria"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "stepId": {
          "type": "string",
          "format": "uuid"
        },
        "agentId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/AttemptState"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "stepId",
        "agentId",
        "state",
        "dependencyIds"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "stepId": {
          "type": "string",
          "format": "uuid"
        },
        "agentId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/AssignmentState"
        },
        "dependencyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "AgentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "agentId",
        "configurationId",
        "parentSessionId",
        "state"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "agentId": {
          "type": "string",
          "format": "uuid"
        },
        "configurationId": {
          "type": "string",
          "format": "uuid"
        },
        "parentSessionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        }
      }
    },
    "AgentMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "senderSessionId",
        "recipientSessionId",
        "content"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "senderSessionId": {
          "type": "string",
          "format": "uuid"
        },
        "recipientSessionId": {
          "type": "string",
          "format": "uuid"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "PreparedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "toolId",
        "resource",
        "parameters",
        "digest",
        "consequences",
        "expiresAt",
        "state",
        "preparationId"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "toolId": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "parameters": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "consequences": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "$ref": "#/$defs/ActionState"
        },
        "preparationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApprovalGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "kind",
        "actionId",
        "operationClass",
        "scope",
        "resource",
        "digest",
        "expiresAt",
        "revoked"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "kind": {
          "$ref": "#/$defs/GrantKind"
        },
        "actionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operationClass": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked": {
          "type": "boolean"
        }
      }
    },
    "ToolInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "execution",
        "preparedActionId",
        "state",
        "externalId",
        "result",
        "exitCode"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/RecordMetadata"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionContext"
        },
        "preparedActionId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/$defs/ActionState"
        },
        "externalId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "anyOf": [
