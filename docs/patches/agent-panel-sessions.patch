diff --git a/apps/shared/WorkspaceV3/WorkspacePanelControls.swift b/apps/shared/WorkspaceV3/WorkspacePanelControls.swift
new file mode 100644
--- /dev/null
+++ b/apps/shared/WorkspaceV3/WorkspacePanelControls.swift
@@ -0,0 +1,124 @@
+import BlotDesign
+import SwiftUI
+
+/// Forms share Blot's surfaces and spacing while retaining native text editing and accessibility.
+struct WorkspacePanelForm<Content: View>: View {
+    @ViewBuilder let content: Content
+    @Environment(\.workspacePanelNavigation) private var panel
+    var body: some View {
+        if panel != nil {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 24) {
+                    Group(sections: content) { sections in
+                        ForEach(sections) { section in
+                            VStack(alignment: .leading, spacing: 12) {
+                                section.header.font(.system(size: 12, weight: .semibold)).foregroundStyle(WorkspaceStyle.secondary)
+                                VStack(alignment: .leading, spacing: 16) { section.content }
+                                    .frame(maxWidth: .infinity, alignment: .leading).padding(18)
+                                    .background(WorkspaceStyle.surface, in: RoundedRectangle(cornerRadius: 18))
+                                section.footer.font(.caption).foregroundStyle(WorkspaceStyle.secondary)
+                            }
+                        }
+                    }
+                }.padding(20)
+            }.background(WorkspaceStyle.canvas).workspacePanelControls()
+        } else { Form { content }.formStyle(.grouped) }
+    }
+}
+
+extension View {
+    @ViewBuilder func workspacePanelControls() -> some View {
+        #if os(macOS)
+        self.teamControls()
+        #else
+        self.buttonStyle(WorkspaceButtonStyle(.secondary)).tint(WorkspaceStyle.ink)
+        #endif
+    }
+}
+
+struct WorkspacePanelTextFieldStyle: TextFieldStyle {
+    @Environment(\.workspacePanelNavigation) private var panel
+    @ViewBuilder func _body(configuration: TextField<Self._Label>) -> some View {
+        #if os(macOS)
+        if panel != nil { configuration.textFieldStyle(MacTeamTextFieldStyle()) }
+        else { configuration.textFieldStyle(.roundedBorder) }
+        #else
+        configuration.textFieldStyle(.roundedBorder)
+        #endif
+    }
+}
+
+struct WorkspacePanelToggleStyle: ToggleStyle {
+    @ViewBuilder func makeBody(configuration: Configuration) -> some View {
+        #if os(macOS)
+        Toggle(isOn: configuration.$isOn) { configuration.label }.toggleStyle(MacTeamSwitchStyle())
+        #else
+        Toggle(isOn: configuration.$isOn) { configuration.label }.toggleStyle(.switch)
+        #endif
+    }
+}
+
+struct WorkspaceChoiceOption<Value: Hashable>: Identifiable {
+    let value: Value
+    let title: String
+    var id: Value { value }
+    init(_ value: Value, _ title: String) { self.value = value; self.title = title }
+}
+
+/// A product-styled choice list; the full selected value remains readable in a narrow pane.
+struct WorkspaceChoice<Value: Hashable>: View {
+    let title: String
+    @Binding var selection: Value
+    let options: [WorkspaceChoiceOption<Value>]
+    @State private var expanded = false
+    @Environment(\.isEnabled) private var enabled
+    var body: some View {
+        VStack(alignment: .leading, spacing: 7) {
+            Text(title).font(.caption).foregroundStyle(WorkspaceStyle.secondary)
+            Button { expanded.toggle() } label: {
+                HStack(spacing: 10) {
+                    Text(options.first { $0.value == selection }?.title ?? "—").multilineTextAlignment(.leading)
+                    Spacer(minLength: 4)
+                    Image(systemName: "chevron.up.chevron.down").font(.system(size: 10, weight: .medium)).foregroundStyle(WorkspaceStyle.secondary)
+                }.padding(12).frame(maxWidth: .infinity, minHeight: 38, alignment: .leading)
+                    .background(WorkspaceStyle.canvas, in: RoundedRectangle(cornerRadius: 12))
+                    .overlay(RoundedRectangle(cornerRadius: 12).strokeBorder(BlotColor.edge))
+                    .contentShape(RoundedRectangle(cornerRadius: 12))
+            }.buttonStyle(.plain).opacity(enabled ? 1 : 0.45)
+                .accessibilityLabel(title).accessibilityValue(options.first { $0.value == selection }?.title ?? "—")
+                .popover(isPresented: $expanded, arrowEdge: .bottom) {
+                    ScrollView {
+                        LazyVStack(spacing: 3) {
+                            ForEach(options) { option in
+                                Button { selection = option.value; expanded = false } label: {
+                                    HStack(spacing: 12) {
+                                        Text(option.title).multilineTextAlignment(.leading)
+                                        Spacer(minLength: 12)
+                                        Image(systemName: "checkmark").opacity(option.value == selection ? 1 : 0)
+                                    }.font(.system(size: 13)).padding(11).frame(maxWidth: .infinity, alignment: .leading)
+                                        .background(option.value == selection ? WorkspaceStyle.surface : .clear, in: RoundedRectangle(cornerRadius: 10))
+                                        .contentShape(RoundedRectangle(cornerRadius: 10))
+                                }.buttonStyle(.plain).accessibilityAddTraits(option.value == selection ? [.isSelected] : [])
+                            }
+                        }.padding(8)
+                    }.frame(idealWidth: 280, maxHeight: 320).background(WorkspaceStyle.canvas).presentationCompactAdaptation(.popover)
+                }
+        }
+    }
+}
+
+struct WorkspaceCounter: View {
+    let title: String
+    @Binding var value: Int
+    let range: ClosedRange<Int>
+    var step = 1
+    var body: some View {
+        HStack {
+            Text(title).font(.callout)
+            Spacer()
+            Button { value = max(range.lowerBound, value - step) } label: { Image(systemName: "minus") }.disabled(value <= range.lowerBound).accessibilityLabel("−\(step)")
+            Text(value.formatted()).monospacedDigit().frame(minWidth: 24)
+            Button { value = min(range.upperBound, value + step) } label: { Image(systemName: "plus") }.disabled(value >= range.upperBound).accessibilityLabel("+\(step)")
+        }.workspacePanelControls()
+    }
+}
diff --git a/apps/shared/WorkspaceV3/WorkspacePanelDateField.swift b/apps/shared/WorkspaceV3/WorkspacePanelDateField.swift
new file mode 100644
--- /dev/null
+++ b/apps/shared/WorkspaceV3/WorkspacePanelDateField.swift
@@ -0,0 +1,68 @@
+import BlotDesign
+import SwiftUI
+
+/// Compact date and time entry uses the same choices and calendar surface as the pane.
+struct WorkspacePanelDateField: View {
+    let title: String
+    @Binding var date: Date
+    var calendarOnly = false
+    @State private var expanded = false
+    @State private var month = Date()
+    @Environment(\.workspacePanelNavigation) private var panel
+    @Environment(\.calendar) private var sourceCalendar
+    @Environment(WorkspaceStore.self) private var store
+    private var ru: Bool { store.language == "ru" }
+    private var calendar: Calendar { var value = sourceCalendar; value.locale = Locale(identifier: store.language); return value }
+    var body: some View {
+        if panel == nil { DatePicker(title, selection: $date, displayedComponents: calendarOnly ? .date : .hourAndMinute) }
+        else if calendarOnly {
+            Button { month = date; expanded = true } label: {
+                HStack { Text(title); Spacer(); Text(date, format: .dateTime.day().month().year()); Image(systemName: "calendar") }
+                    .padding(12).frame(maxWidth: .infinity).background(WorkspaceStyle.canvas, in: RoundedRectangle(cornerRadius: 12))
+            }.buttonStyle(.plain).popover(isPresented: $expanded, arrowEdge: .bottom) { calendarPage }
+        } else {
+            HStack(alignment: .top, spacing: 10) {
+                WorkspaceChoice(title: title, selection: component(.hour), options: (0..<24).map { .init($0, String(format: "%02d", $0)) })
+                WorkspaceChoice(title: ru ? "Минуты" : "Minutes", selection: component(.minute), options: (0..<60).map { .init($0, String(format: "%02d", $0)) })
+            }
+        }
+    }
+    private func component(_ unit: Calendar.Component) -> Binding<Int> {
+        Binding(get: { calendar.component(unit, from: date) }, set: { if let value = calendar.date(bySetting: unit, value: $0, of: date) { date = value } })
+    }
+    private var calendarPage: some View {
+        VStack(spacing: 16) {
+            HStack {
+                Button { moveMonth(-1) } label: { Image(systemName: "chevron.left") }.accessibilityLabel(ru ? "Предыдущий месяц" : "Previous month")
+                Spacer()
+                Text(month.formatted(.dateTime.month(.wide).year().locale(Locale(identifier: store.language)))).font(.headline)
+                Spacer()
+                Button { moveMonth(1) } label: { Image(systemName: "chevron.right") }.accessibilityLabel(ru ? "Следующий месяц" : "Next month")
+            }
+            LazyVGrid(columns: Array(repeating: GridItem(.flexible(), spacing: 4), count: 7), spacing: 4) {
+                ForEach(0..<7, id: \.self) { index in
+                    Text(calendar.veryShortStandaloneWeekdaySymbols[(calendar.firstWeekday - 1 + index) % 7]).font(.caption).foregroundStyle(WorkspaceStyle.secondary)
+                }
+                ForEach(Array(days.enumerated()), id: \.offset) { _, day in
+                    if let day {
+                        Button { select(day) } label: {
+                            Text(calendar.component(.day, from: day).formatted()).monospacedDigit().frame(width: 30, height: 30)
+                                .foregroundStyle(calendar.isDate(day, inSameDayAs: date) ? BlotColor.onInverse : WorkspaceStyle.ink)
+                                .background(calendar.isDate(day, inSameDayAs: date) ? BlotColor.inverse : .clear, in: Circle())
+                        }.buttonStyle(.plain).accessibilityLabel(day.formatted(.dateTime.weekday(.wide).day().month(.wide).year().locale(Locale(identifier: store.language))))
+                    } else { Color.clear.frame(width: 30, height: 30) }
+                }
+            }
+        }.padding(16).frame(width: 280).background(WorkspaceStyle.canvas).workspacePanelControls().presentationCompactAdaptation(.popover)
+    }
+    private var days: [Date?] {
+        guard let start = calendar.dateInterval(of: .month, for: month)?.start, let range = calendar.range(of: .day, in: .month, for: start) else { return [] }
+        let offset = (calendar.component(.weekday, from: start) - calendar.firstWeekday + 7) % 7
+        return Array(repeating: nil, count: offset) + range.map { calendar.date(byAdding: .day, value: $0 - 1, to: start) }
+    }
+    private func moveMonth(_ amount: Int) { if let next = calendar.date(byAdding: .month, value: amount, to: month) { month = next } }
+    private func select(_ day: Date) {
+        let time = calendar.dateComponents([.hour, .minute], from: date)
+        if let next = calendar.date(bySettingHour: time.hour ?? 0, minute: time.minute ?? 0, second: 0, of: day) { date = next; expanded = false }
+    }
+}
