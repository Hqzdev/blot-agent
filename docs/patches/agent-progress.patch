+        await store.newChat(with: agent)
+        store.form.composer.draft = "Создай документ"
+        await store.perform(.send)
+        for _ in 0..<300 {
+            if !store.isReplying { break }
+            try await _Concurrency.Task.sleep(for: .milliseconds(20))
