+    }
+    private func details(_ call: ChatToolCall, result: ChatJSON?) -> [WorkspaceToolActivity.Detail] {
+        let arguments = fields(call.arguments), output = fields(result)
+        var items: [WorkspaceToolActivity.Detail] = []
+        var truncated = false
+        if let path = arguments["path"].flatMap(string) { items.append(.init(label: "Файл / File", value: clean(path, maximum: 240))) }
+        if let url = arguments["url"].flatMap(string).flatMap(URL.init(string:)), let host = url.host { items.append(.init(label: "Сайт / Site", value: clean(host))) }
+        if let executable = arguments["executable"].flatMap(string) { items.append(.init(label: "Программа / Program", value: (executable as NSString).lastPathComponent)) }
+        // Never echo arbitrary parameters, page text, environment variables or opaque plugin output.
+        for (key, title) in [("title", "Название / Title"), ("name", "Название / Name"), ("exitCode", "Код выхода / Exit code"), ("stdout", "stdout"), ("stderr", "stderr")] {
+            guard let value = output[key] else { continue }
+            let text: String
+            if let value = string(value) { text = value }
+            else if case .number(let value) = value { text = String(value) }
+            else { continue }
+            truncated = truncated || text.count > 3000
+            if !text.isEmpty { items.append(.init(label: title, value: clean(text, maximum: 3000))) }
+        }
+        if output["truncated"] == .bool(true) || truncated { items.append(.init(label: "Журнал / Log", value: "Показан фрагмент / Output truncated")) }
+        return items
+    }
+    private func clean(_ value: String, maximum: Int = 160) -> String {
+        String(String(value.unicodeScalars.filter { !CharacterSet.controlCharacters.contains($0) || $0 == "\n" || $0 == "\t" }).prefix(maximum))
+    }
+    private func fields(_ value: ChatJSON?) -> [String: ChatJSON] { if case .object(let values) = value { return values }; return [:] }
+    private func string(_ value: ChatJSON) -> String? { if case .string(let text) = value { return text }; return nil }
+    private func decode<T: Decodable>(_ raw: String?) -> T? {
+        guard let raw, raw.utf8.count <= 4_194_304 else { return nil }
+        return try? JSONDecoder().decode(T.self, from: Data(raw.utf8))
+    }
+}
diff --git a/apps/shared/WorkspaceV3/WorkspaceToolActivityView.swift b/apps/shared/WorkspaceV3/WorkspaceToolActivityView.swift
new file mode 100644
--- /dev/null
+++ b/apps/shared/WorkspaceV3/WorkspaceToolActivityView.swift
@@ -0,0 +1,85 @@
+import BlotDesign
+import BlotDomain
+import SwiftUI
+
+struct WorkspaceToolActivityView: View {
+    let message: BlotV3.Message
+    @Environment(WorkspaceStore.self) private var store
+    @State private var showsAll = false
+    private var russian: Bool { store.language == "ru" }
+    var body: some View {
+        let rows = store.chatContent.activities(for: message)
+        if !rows.isEmpty {
+            VStack(alignment: .leading, spacing: 3) {
+                ForEach(showsAll ? rows : Array(rows.suffix(4))) { row in
+                    WorkspaceToolActivityRow(row: row, russian: russian)
+                }
+                if rows.count > 4 {
+                    Button(showsAll ? (russian ? "Свернуть действия" : "Show fewer actions") : (russian ? "Все действия (\(rows.count))" : "All actions (\(rows.count))")) { showsAll.toggle() }
+                        .font(.caption).buttonStyle(.plain).foregroundStyle(.secondary).padding(.leading, 27).padding(.vertical, 5)
+                }
+                if rows.count == 64 { Text(russian ? "Показаны последние 64 действия" : "Showing the latest 64 actions").font(.caption2).foregroundStyle(.secondary) }
+            }.accessibilityIdentifier("workspace.chat.tool-activity.\(message.metadata.id)")
+        }
+    }
+}
+
+private struct WorkspaceToolActivityRow: View {
+    let row: WorkspaceToolActivity
+    let russian: Bool
+    @Environment(WorkspaceStore.self) private var store
+    @State private var expanded = false
+    private var minimumHeight: CGFloat {
+        #if os(iOS)
+        44
+        #else
+        30
+        #endif
+    }
+    private var terminalFailure: Bool { row.state == .failed || row.state == .denied || row.state == .unknown }
+    var body: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            Button { expanded.toggle() } label: {
+                HStack(alignment: .center, spacing: 8) {
+                    if let plugin = row.plugin { WorkspacePluginLogo(plugin: plugin, size: 20).clipShape(RoundedRectangle(cornerRadius: 4)) }
+                    else { Image(systemName: row.symbol).frame(width: 20, height: 20).accessibilityHidden(true) }
+                    ViewThatFits(in: .horizontal) {
+                        HStack(spacing: 5) { name; provider }
+                        VStack(alignment: .leading, spacing: 2) { name; provider }
+                    }.frame(maxWidth: .infinity, alignment: .leading)
+                    if row.state == .running { ProgressView().controlSize(.mini).accessibilityLabel(row.status(russian: russian)) }
+                    else if row.state != .succeeded { Text(row.status(russian: russian)).font(.caption2).foregroundStyle(terminalFailure ? .red : .secondary) }
+                    Image(systemName: expanded ? "chevron.down" : "chevron.right").font(.system(size: 10)).accessibilityHidden(true)
+                }
+                .font(.system(size: 12, weight: .regular)).foregroundStyle(WorkspaceStyle.secondary).padding(.horizontal, 7).padding(.vertical, 6)
+                .frame(minHeight: minimumHeight).contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+            .accessibilityLabel(row.title(russian: russian) + ", " + row.status(russian: russian))
+            .accessibilityValue(expanded ? (russian ? "Развёрнуто" : "Expanded") : (russian ? "Свёрнуто" : "Collapsed"))
+            .accessibilityIdentifier("workspace.chat.tool-action.\(row.id)")
+            if expanded {
+                VStack(alignment: .leading, spacing: 7) {
+                    Text(row.status(russian: russian)).font(.caption.weight(.medium))
+                    ForEach(Array(row.details.enumerated()), id: \.offset) { _, item in
+                        VStack(alignment: .leading, spacing: 2) {
+                            Text(russian ? (item.label.components(separatedBy: " / ").first ?? item.label) : (item.label.components(separatedBy: " / ").last ?? item.label)).font(.caption2).foregroundStyle(.secondary)
+                            Text(item.label == "Журнал / Log" ? (russian ? "Показан фрагмент" : "Output truncated") : item.value).font(.caption.monospaced()).textSelection(.enabled).fixedSize(horizontal: false, vertical: true)
+                        }
+                    }
+                    if row.details.isEmpty { Text(russian ? "Статус получен из журнала выполнения." : "Status comes from the execution log.").font(.caption).foregroundStyle(.secondary) }
+                    if let id = row.logArtifactID, store.chatContent.artifacts[id] != nil {
+                        Button(russian ? "Открыть полный журнал" : "Open full log") { store.selectedRecordID = id; store.navigate(.file) }
+                            .font(.caption).buttonStyle(.bordered)
+                    }
+                }.padding(.leading, 35).padding(.bottom, 8)
+            }
+        }
+    }
+    private var name: some View { Text(row.title(russian: russian)).multilineTextAlignment(.leading) }
+    @ViewBuilder private var provider: some View {
+        if let provider = row.provider {
+            Text("@" + provider).foregroundStyle(row.plugin?.color ?? .secondary).multilineTextAlignment(.leading)
+        }
+    }
+}
diff --git a/scripts/check-agent-progress.sh b/scripts/check-agent-progress.sh
new file mode 100755
--- /dev/null
+++ b/scripts/check-agent-progress.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+products="$PWD/.build/xcode/Build/Products/Debug"
+checks="$PWD/.build/agent-progress/harness"
+mkdir -p "$checks/cache"
+python3 - <<'PY'
+from pathlib import Path
+objects=Path('.build/xcode/Build/Intermediates.noindex/Blot.build/Debug/Blot.build/Objects-normal/arm64')
+items=sorted(p.resolve() for p in objects.glob('*.o') if p.name != 'BlotMacApp.o')
+assert items and all('"' not in str(p) for p in items)
+Path('.build/agent-progress/harness/objects.txt').write_text('\n'.join('"'+str(p)+'"' for p in items)+'\n')
+PY
+xcrun swiftc -parse-as-library -swift-version 5 -default-isolation MainActor -module-cache-path "$checks/cache" \
+    -I "$products" -I packages/BlotWorkspace/Sources/CSQLite \
+    "$products/BlotDomain.o" "$products/BlotWorkspace.o" "$products/BlotAppleIntegrations.o" "$products/BlotDesign.o" "$products/BlotAPI.o" \
+    @"$checks/objects.txt" -lsqlite3 scripts/verify-agent-progress.swift -o "$checks/verify"
+"$checks/verify"
