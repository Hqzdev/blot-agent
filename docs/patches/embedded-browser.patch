+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserDialog.swift
@@ -0,0 +1,33 @@
+import Foundation
+import Observation
+import WebKit
+
+@MainActor @Observable
+public final class BrowserDialog: Identifiable {
+    public enum Kind { case alert, confirmation, prompt }
+    public let id = UUID()
+    public let kind: Kind
+    public let message: String
+    public let origin: String
+    public var input: String
+    @ObservationIgnored private var reply: ((String?) -> Void)?
+    init(kind: Kind, message: String, origin: String, input: String = "", reply: @escaping (String?) -> Void) {
+        self.kind = kind; self.message = String(message.prefix(2000)); self.origin = origin; self.input = input; self.reply = reply
+    }
+    public func finish(accepted: Bool) { let callback = reply; reply = nil; callback?(accepted ? input : nil) }
+}
+
+extension BrowserPage {
+    func webView(_ webView: WKWebView, runJavaScriptAlertPanelWithMessage message: String, initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping @MainActor @Sendable () -> Void) {
+        guard let owner, owner.dialog == nil else { completionHandler(); return }
+        owner.dialog = BrowserDialog(kind: .alert, message: message, origin: frame.securityOrigin.host) { [weak owner] _ in owner?.dialog = nil; completionHandler() }
+    }
+    func webView(_ webView: WKWebView, runJavaScriptConfirmPanelWithMessage message: String, initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping @MainActor @Sendable (Bool) -> Void) {
+        guard let owner, owner.dialog == nil else { completionHandler(false); return }
+        owner.dialog = BrowserDialog(kind: .confirmation, message: message, origin: frame.securityOrigin.host) { [weak owner] value in owner?.dialog = nil; completionHandler(value != nil) }
+    }
+    func webView(_ webView: WKWebView, runJavaScriptTextInputPanelWithPrompt prompt: String, defaultText: String?, initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping @MainActor @Sendable (String?) -> Void) {
+        guard let owner, owner.dialog == nil else { completionHandler(nil); return }
+        owner.dialog = BrowserDialog(kind: .prompt, message: prompt, origin: frame.securityOrigin.host, input: defaultText ?? "") { [weak owner] value in owner?.dialog = nil; completionHandler(value) }
+    }
+}
diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserDownloadHandler.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserDownloadHandler.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserDownloadHandler.swift
@@ -0,0 +1,43 @@
+import BlotWorkspace
+import Foundation
+import WebKit
+#if os(macOS)
+import AppKit
+#endif
+
+@MainActor
+final class BrowserDownloadHandler: NSObject, WKDownloadDelegate {
+    private weak var owner: WorkspaceBrowserController?
+    init(owner: WorkspaceBrowserController) { self.owner = owner }
+    func download(_ download: WKDownload, decideDestinationUsing response: URLResponse, suggestedFilename: String, completionHandler: @escaping @MainActor @Sendable (URL?) -> Void) {
+        guard let owner, let item = owner.downloads.first(where: { $0.download === download }), !owner.stopped else { completionHandler(nil); return }
+        let safe = String(suggestedFilename.filter { $0 != "/" && $0 != "\\" && !$0.isNewline }.prefix(180))
+        item.name = safe.isEmpty || safe == "." || safe == ".." ? "download" : safe
+        if let choose = owner.chooseDownload {
+            Task {
+                guard let url = await choose(item.name), url.isFileURL, !owner.stopped else { item.state = "canceled"; completionHandler(nil); return }
+                item.url = url; completionHandler(url)
+            }
+            return
+        }
+        #if os(macOS)
+        let panel = NSSavePanel(); panel.nameFieldStringValue = item.name
+        guard let window = download.webView?.window else { item.state = "canceled"; completionHandler(nil); return }
+        panel.beginSheetModal(for: window) { result in
+            guard result == .OK, let url = panel.url, !owner.stopped else { item.state = "canceled"; completionHandler(nil); return }
+            item.url = url; completionHandler(url)
+        }
+        #else
+        do {
+            let directory = owner.downloadsDirectory.appendingPathComponent(item.id.uuidString, isDirectory: true)
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let url = directory.appendingPathComponent(item.name); item.url = url; completionHandler(url)
+        } catch { item.state = "failed"; item.error = "Не удалось сохранить загрузку."; completionHandler(nil) }
+        #endif
+    }
+    func downloadDidFinish(_ download: WKDownload) { owner?.downloads.first { $0.download === download }?.state = "completed" }
+    func download(_ download: WKDownload, didFailWithError error: Error, resumeData: Data?) {
+        guard let item = owner?.downloads.first(where: { $0.download === download }) else { return }
+        if item.state != "canceled" { item.state = "failed"; item.error = "Загрузка не завершена. Автоматического повтора нет." }
+    }
+}
diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserExecution.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserExecution.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserExecution.swift
@@ -0,0 +1,93 @@
+import BlotWorkspace
+import Foundation
+import WebKit
+#if os(macOS)
+import AppKit
+#else
+import UIKit
+#endif
+
+extension WorkspaceBrowserController {
+    public func prepare(_ command: WorkspaceBrowserCommand) async throws -> WorkspaceBrowserBinding {
+        guard !stopped, WorkspaceBrowserCatalog.toolIDs.contains(command.name) else { throw WorkspaceBrowserError.unavailable }
+        let arguments = try AppleArguments(command.arguments)
+        if command.name == "browser_open" {
+            let url = try WorkspaceBrowserURL.validated(arguments.required("url"))
+            guard command.origins.contains(try WorkspaceBrowserURL.origin(url)) else { throw WorkspaceBrowserError.denied }
+            if let tab = tabs.first(where: { $0.id == command.id }) {
+                guard tab.scope == command.scope, tab.initialURL == url, !tab.stopped else { throw WorkspaceBrowserError.denied }
+                return .init(tabID: tab.id, documentID: tab.documentID, url: url.absoluteString)
+            }
+            return .init(tabID: command.id, documentID: command.id, url: url.absoluteString)
+        }
+        let tab = try ownedTab(arguments, command: command)
+        guard pages[tab.id] != nil, !tab.loading, let url = tab.url else { throw WorkspaceBrowserError.stalePage }
+        if WorkspaceBrowserCatalog.requiresConfirmation(command.name) {
+            guard arguments["document_id"] == tab.documentID.uuidString, let page = pages[tab.id], !busyTabs.contains(tab.id) else { throw WorkspaceBrowserError.stalePage }
+            let element = try arguments.required("element_id")
+            let value = try await page.script(BrowserDOM.target, arguments: ["element": element])
+            guard case .string(let target) = value, target.utf8.count < 4096 else { throw WorkspaceBrowserError.stalePage }
+            return .init(tabID: tab.id, documentID: tab.documentID, url: url.absoluteString, target: target, interactionRevision: tab.interactionRevision)
+        }
+        return .init(tabID: tab.id, documentID: tab.documentID, url: url.absoluteString, interactionRevision: tab.interactionRevision)
+    }
+    public func execute(_ command: WorkspaceBrowserCommand, binding: WorkspaceBrowserBinding) async throws -> WorkspaceBrowserResult {
+        guard !stopped else { throw WorkspaceBrowserError.unavailable }
+        let arguments = try AppleArguments(command.arguments)
+        if command.name == "browser_open" {
+            guard try await prepare(command) == binding else { throw WorkspaceBrowserError.stalePage }
+            let tab: BrowserTab
+            if let existing = tabs.first(where: { $0.id == binding.tabID }) { tab = existing }
+            else {
+                guard tabs.count < 32 else { throw WorkspaceBrowserError.busy }
+                tab = BrowserTab(id: binding.tabID, url: URL(string: binding.url), scope: command.scope, origins: command.origins)
+                try createPage(tab); tabsAppend(tab); pages[tab.id]?.load(URL(string: binding.url)!)
+            }
+            guard let page = pages[tab.id] else { throw WorkspaceBrowserError.stalePage }
+            busyTabs.insert(tab.id); defer { busyTabs.remove(tab.id) }
+            try await page.waitForLoad(); return .value(state(tab))
+        }
+        let tab = try ownedTab(arguments, command: command)
+        guard tab.id == binding.tabID, tab.documentID == binding.documentID, tab.url?.absoluteString == binding.url,
+              tab.interactionRevision == binding.interactionRevision,
+              let page = pages[tab.id], busyTabs.insert(tab.id).inserted else { throw WorkspaceBrowserError.stalePage }
+        defer { busyTabs.remove(tab.id) }
+        switch command.name {
+        case "browser_snapshot":
+            let value = try await page.script(BrowserDOM.snapshot)
+            guard case .object(var fields) = value, tab.documentID == binding.documentID else { throw WorkspaceBrowserError.stalePage }
+            fields["tab_id"] = .string(tab.id.uuidString); fields["document_id"] = .string(tab.documentID.uuidString)
+            fields["url"] = .string(binding.url); fields["title"] = .string(tab.title)
+            return .value(.object(fields))
+        case "browser_click", "browser_type":
+            guard (arguments["text"] ?? "").utf8.count <= 8192 else { throw WorkspaceBrowserError.denied }
+            if command.name == "browser_click" { page.view.configuration.preferences.javaScriptCanOpenWindowsAutomatically = true }
+            defer { page.view.configuration.preferences.javaScriptCanOpenWindowsAutomatically = false }
+            let result = try await page.script(BrowserDOM.action, arguments: ["element": try arguments.required("element_id"), "expected": binding.target, "kind": command.name, "text": arguments["text"] ?? ""])
+            if case .object(var fields) = result {
+                fields["tabs"] = .array(tabs.filter { $0.scope == command.scope }.map(state))
+                return .value(.object(fields))
+            }
+            return .value(result)
+        case "browser_scroll": return .value(try await page.script(BrowserDOM.scroll, arguments: ["direction": arguments["direction"] ?? "down"]))
+        case "browser_back": try back(tab.id); try await page.waitForLoad(); return .value(state(tab))
+        case "browser_close": try close(tab.id); return .value(.object(["state": .string("closed")]))
+        case "browser_screenshot":
+            if tab.sensitiveInput { throw WorkspaceBrowserError.denied }
+            if try await page.script(BrowserDOM.sensitive) == .bool(true) { throw WorkspaceBrowserError.denied }
+            let data = try await page.snapshot()
+            guard tab.documentID == binding.documentID else { throw WorkspaceBrowserError.stalePage }
+            return .image(data)
+        default: throw WorkspaceBrowserError.denied
+        }
+    }
+    private func ownedTab(_ arguments: AppleArguments, command: WorkspaceBrowserCommand) throws -> BrowserTab {
+        guard let raw = arguments["tab_id"], let id = UUID(uuidString: raw), let tab = tabs.first(where: { $0.id == id }),
+              tab.scope == command.scope, !tab.stopped, let url = tab.url,
+              command.origins.contains(try WorkspaceBrowserURL.origin(url)) else { throw WorkspaceBrowserError.denied }
+        return tab
+    }
+    private func state(_ tab: BrowserTab) -> ChatJSON {
+        .object(["tab_id": .string(tab.id.uuidString), "document_id": .string(tab.documentID.uuidString), "url": .string(tab.url?.absoluteString ?? ""), "title": .string(tab.title), "state": .string(tab.loading ? "loading" : "ready")])
+    }
+}
diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserPage.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserPage.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserPage.swift
@@ -0,0 +1,187 @@
+import BlotWorkspace
+import Foundation
+import WebKit
+#if os(macOS)
+import AppKit
+#else
+import UIKit
+#endif
+
+@MainActor
+final class BrowserPage: NSObject, WKNavigationDelegate, WKUIDelegate, WKScriptMessageHandler {
+    static let world = WKContentWorld.world(name: "dev.blot.browser")
+    let tab: BrowserTab
+    let view: WKWebView
+    weak var owner: WorkspaceBrowserController?
+    private var observations: [NSKeyValueObservation] = []
+    private var loads: [UUID: CheckedContinuation<Void, Error>] = [:]
+    private var scripts: [UUID: CheckedContinuation<ChatJSON, Error>] = [:]
+    private var images: [UUID: CheckedContinuation<Data, Error>] = [:]
+    private var timers: [UUID: Task<Void, Never>] = [:]
+    init(tab: BrowserTab, owner: WorkspaceBrowserController, dataStore: WKWebsiteDataStore) {
+        self.tab = tab; self.owner = owner
+        let config = WKWebViewConfiguration(); config.websiteDataStore = dataStore
+        config.preferences.javaScriptCanOpenWindowsAutomatically = false
+        config.userContentController.addUserScript(WKUserScript(source: BrowserDOM.bootstrap, injectionTime: .atDocumentEnd, forMainFrameOnly: false, in: Self.world))
+        view = WKWebView(frame: CGRect(x: 0, y: 0, width: 1000, height: 720), configuration: config)
+        super.init()
+        config.userContentController.add(self, contentWorld: Self.world, name: "blotDirty")
+        view.navigationDelegate = self; view.uiDelegate = self
+        observations = [view.observe(\.estimatedProgress, options: [.new]) { [weak self] _, _ in Task { @MainActor in self?.refresh() } },
+                        view.observe(\.title, options: [.new]) { [weak self] _, _ in Task { @MainActor in self?.refresh() } },
+                        view.observe(\.url, options: [.new]) { [weak self] _, _ in Task { @MainActor in self?.refresh() } },
+                        view.observe(\.canGoBack, options: [.new]) { [weak self] _, _ in Task { @MainActor in self?.refresh() } },
+                        view.observe(\.canGoForward, options: [.new]) { [weak self] _, _ in Task { @MainActor in self?.refresh() } }]
+    }
+    func load(_ url: URL) { tab.error = nil; tab.authenticationURL = nil; tab.loading = true; view.load(URLRequest(url: url)) }
+    func refresh() {
+        if let url = view.url, (try? WorkspaceBrowserURL.validated(url.absoluteString)) != nil { tab.url = url }
+        tab.progress = view.estimatedProgress; tab.title = view.title?.isEmpty == false ? view.title! : tab.url?.host ?? "Новая вкладка"
+        tab.canGoBack = view.canGoBack; tab.canGoForward = view.canGoForward
+    }
+    func snapshot() async throws -> Data {
+        let id = UUID()
+        return try await withCheckedThrowingContinuation { continuation in
+            images[id] = continuation
+            let configuration = WKSnapshotConfiguration()
+            let width = max(1, min(1000, view.bounds.width))
+            configuration.rect = CGRect(x: view.bounds.minX, y: view.bounds.minY, width: view.bounds.width, height: min(view.bounds.height, 2_000_000 / width))
+            configuration.snapshotWidth = NSNumber(value: Double(width))
+            view.takeSnapshot(with: configuration) { [weak self] image, error in
+                guard let self, let reply = self.images.removeValue(forKey: id) else { return }
+                self.timers.removeValue(forKey: id)?.cancel()
+                #if os(macOS)
+                let data = image?.tiffRepresentation.flatMap(NSBitmapImageRep.init(data:))?.representation(using: .png, properties: [:])
+                #else
+                let data = image?.pngData()
+                #endif
+                if let data { reply.resume(returning: data) } else { reply.resume(throwing: WorkspaceBrowserError.unavailable) }
+            }
+            timers[id] = Task { [weak self] in
+                do { try await Task.sleep(for: .seconds(8)); self?.images.removeValue(forKey: id)?.resume(throwing: WorkspaceBrowserError.timeout); self?.timers.removeValue(forKey: id) } catch {}
+            }
+        }
+    }
+    func waitForLoad() async throws {
+        guard tab.loading || view.isLoading else { if tab.error != nil { throw WorkspaceBrowserError.unavailable }; return }
+        let id = UUID()
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            loads[id] = continuation
+            timers[id] = Task { [weak self] in
+                do { try await Task.sleep(for: .seconds(20)); self?.finishLoad(id, error: WorkspaceBrowserError.timeout) } catch {}
+            }
+        }
+    }
+    func script(_ script: String, arguments: [String: Any] = [:]) async throws -> ChatJSON {
+        let id = UUID()
+        return try await withCheckedThrowingContinuation { continuation in
+            scripts[id] = continuation
+            view.callAsyncJavaScript(BrowserDOM.bootstrap + "\n" + script, arguments: arguments, in: nil, in: Self.world) { [weak self] result in
+                guard let self, let continuation = self.scripts.removeValue(forKey: id) else { return }
+                self.timers.removeValue(forKey: id)?.cancel()
+                switch result {
+                case .success(let value):
+                    do {
+                        let data = try JSONSerialization.data(withJSONObject: value, options: .fragmentsAllowed)
+                        continuation.resume(returning: try JSONDecoder().decode(ChatJSON.self, from: data))
+                    } catch { continuation.resume(throwing: WorkspaceBrowserError.unknown) }
+                case .failure(let error):
+                    let message = (error as NSError).userInfo["WKJavaScriptExceptionMessage"] as? String ?? ""
+                    continuation.resume(throwing: message.contains("stale_or_manual") || message.contains("manual_field") ? WorkspaceBrowserError.stalePage : WorkspaceBrowserError.unknown)
+                }
+            }
+            timers[id] = Task { [weak self] in
+                do {
+                    try await Task.sleep(for: .seconds(8))
+                    self?.scripts.removeValue(forKey: id)?.resume(throwing: WorkspaceBrowserError.timeout); self?.timers.removeValue(forKey: id)
+                } catch {}
+            }
+        }
+    }
+    func stop() {
+        view.stopLoading(); tab.loading = false
+        for timer in timers.values { timer.cancel() }; timers.removeAll()
+        let waiting = loads.values; loads.removeAll(); for item in waiting { item.resume(throwing: WorkspaceBrowserError.canceled) }
+        let running = scripts.values; scripts.removeAll(); for item in running { item.resume(throwing: WorkspaceBrowserError.canceled) }
+        let snapshots = images.values; images.removeAll(); for item in snapshots { item.resume(throwing: WorkspaceBrowserError.canceled) }
+    }
+    func detach() {
+        stop(); observations.removeAll()
+        view.configuration.userContentController.removeScriptMessageHandler(forName: "blotDirty", contentWorld: Self.world)
+        view.navigationDelegate = nil; view.uiDelegate = nil
+        view.loadHTMLString("", baseURL: nil)
+    }
+    private func finishLoad(_ id: UUID, error: Error? = nil) {
+        timers.removeValue(forKey: id)?.cancel()
+        guard let item = loads.removeValue(forKey: id) else { return }
+        if let error { item.resume(throwing: error) } else { item.resume() }
+    }
+    func webView(_ webView: WKWebView, didStartProvisionalNavigation navigation: WKNavigation!) {
+        tab.documentID = UUID(); tab.loading = true; tab.error = nil
+    }
+    func webView(_ webView: WKWebView, didCommit navigation: WKNavigation!) {
+        tab.url = webView.url; tab.unsaved = false; tab.sensitiveInput = false; refresh()
+    }
+    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+        tab.loading = false; refresh(); owner?.saveTabs()
+        for id in Array(loads.keys) { finishLoad(id) }
+    }
+    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) { failed(error) }
+    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) { failed(error) }
+    private func failed(_ error: Error) {
+        tab.loading = false
+        if (error as NSError).code != NSURLErrorCancelled { tab.error = "Не удалось загрузить страницу." }
+        for id in Array(loads.keys) { finishLoad(id, error: WorkspaceBrowserError.unavailable) }
+    }
+    func webViewWebContentProcessDidTerminate(_ webView: WKWebView) {
+        stop(); tab.documentID = UUID(); tab.error = "Процесс сайта завершился. Обновите страницу вручную; действие агента не повторяется."
+    }
+    func webView(_ webView: WKWebView, decidePolicyFor navigationAction: WKNavigationAction, decisionHandler: @escaping @MainActor @Sendable (WKNavigationActionPolicy) -> Void) {
+        guard let url = navigationAction.request.url else { decisionHandler(.cancel); return }
+        if url.absoluteString == "about:blank" { decisionHandler(.allow); return }
+        if navigationAction.shouldPerformDownload, url.scheme == "blob",
+           let source = URL(string: String(url.absoluteString.dropFirst(5))), owner?.permits(source, tab: tab) == true { decisionHandler(.download); return }
+        guard (try? WorkspaceBrowserURL.validated(url.absoluteString)) != nil else {
+            tab.error = "Эта ссылка не открывается во внешнем приложении автоматически."; decisionHandler(.cancel); return
+        }
+        if navigationAction.targetFrame?.isMainFrame != false {
+            if WorkspaceBrowserURL.isRestrictedAuthentication(url) { tab.authenticationURL = url; tab.loading = false; tab.error = WorkspaceBrowserError.manualSignIn.localizedDescription; decisionHandler(.cancel); return }
+            guard owner?.permits(url, tab: tab) == true, !tab.stopped else { tab.error = WorkspaceBrowserError.denied.localizedDescription; decisionHandler(.cancel); return }
+            if tab.unsaved && navigationAction.navigationType != .formSubmitted && navigationAction.navigationType != .formResubmitted {
+                tab.error = WorkspaceBrowserError.unsavedChanges.localizedDescription; decisionHandler(.cancel); return
+            }
+        }
+        decisionHandler(navigationAction.shouldPerformDownload ? .download : .allow)
+    }
+    func webView(_ webView: WKWebView, decidePolicyFor navigationResponse: WKNavigationResponse, decisionHandler: @escaping @MainActor @Sendable (WKNavigationResponsePolicy) -> Void) {
+        decisionHandler(navigationResponse.canShowMIMEType ? .allow : .download)
+    }
+    func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration, for navigationAction: WKNavigationAction, windowFeatures: WKWindowFeatures) -> WKWebView? {
+        guard let url = navigationAction.request.url, let owner, owner.permits(url, tab: tab) else { return nil }
+        do {
+            let child = BrowserTab(url: url, scope: tab.scope, origins: tab.allowedOrigins)
+            try owner.createPage(child); owner.tabsAppend(child); owner.pages[child.id]?.load(url)
+        } catch { tab.error = error.localizedDescription }
+        return nil
+    }
+    func webView(_ webView: WKWebView, navigationAction: WKNavigationAction, didBecome download: WKDownload) { downloading(download) }
+    func webView(_ webView: WKWebView, navigationResponse: WKNavigationResponse, didBecome download: WKDownload) { downloading(download) }
+    private func downloading(_ download: WKDownload) {
+        tab.loading = false
+        owner?.beginDownload(download, tabID: tab.id)
+        for id in Array(loads.keys) { finishLoad(id) }
+    }
+    func userContentController(_ userContentController: WKUserContentController, didReceive message: WKScriptMessage) {
+        guard message.name == "blotDirty" else { return }
+        if let dirty = message.body as? Bool, dirty { tab.unsaved = true; tab.interactionRevision += 1 }
+        if let fields = message.body as? [String: Bool], fields["sensitive"] == true { tab.sensitiveInput = true }
+    }
+    #if os(macOS)
+    func webView(_ webView: WKWebView, runOpenPanelWith parameters: WKOpenPanelParameters, initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping @MainActor @Sendable ([URL]?) -> Void) {
+        let panel = NSOpenPanel(); panel.allowsMultipleSelection = parameters.allowsMultipleSelection; panel.canChooseDirectories = parameters.allowsDirectories
+        guard let window = webView.window else { completionHandler(nil); return }
+        panel.beginSheetModal(for: window) { response in completionHandler(response == .OK ? panel.urls : nil) }
+    }
+    #endif
+    func webView(_ webView: WKWebView, requestMediaCapturePermissionFor origin: WKSecurityOrigin, initiatedByFrame frame: WKFrameInfo, type: WKMediaCaptureType, decisionHandler: @escaping @MainActor @Sendable (WKPermissionDecision) -> Void) { decisionHandler(.deny) }
+}
diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserTab.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/BrowserTab.swift
new file mode 100644
