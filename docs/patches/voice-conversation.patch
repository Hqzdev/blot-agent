diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/VoiceInterfaces.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/VoiceInterfaces.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/VoiceInterfaces.swift
@@ -0,0 +1,69 @@
+import Foundation
+
+public enum VoiceFailure: Error, LocalizedError, Equatable {
+    case microphoneDenied, languageUnavailable, voiceUnavailable, audioUnavailable, audioOverrun, interrupted, emptyResponse
+    public var errorDescription: String? {
+        switch self {
+        case .microphoneDenied: "Разрешите микрофон для Blot в системных настройках."
+        case .languageUnavailable: "Локальное распознавание этого языка недоступно на устройстве."
+        case .voiceUnavailable: "На устройстве нет голоса для выбранного языка."
+        case .audioUnavailable: "Не удалось включить аудиоустройство. Проверьте микрофон и наушники."
+        case .audioOverrun: "Устройство не успевает распознавать звук. Начните разговор заново."
+        case .interrupted: "Аудиоустройство изменилось или разговор был прерван. Начните разговор заново."
+        case .emptyResponse: "Ответ не завершён. Проверьте результат в чате перед повтором запроса."
+        }
+    }
+}
+
+@MainActor public protocol VoiceRecognizing: AnyObject {
+    func prepare(locale: Locale) async throws
+    func start(update: @escaping @MainActor (String) -> Void, activity: @escaping @MainActor () -> Void,
+               failure: @escaping @MainActor (Error) -> Void) async throws
+    func finish() async throws -> String
+    func stop() async
+}
+@MainActor public protocol VoiceSpeaking: AnyObject {
+    func prepare(locale: Locale) throws
+    func speak(_ text: String) async throws
+    func stop()
+}
+
+/// Speech modules may revise an overlapping interval before finalizing it.
+public struct VoiceTranscript: Sendable {
+    private struct Segment: Sendable { let start: Double; let end: Double; let text: String }
+    private var segments: [Segment] = []
+    public init() {}
+    public mutating func replace(start: Double, end: Double, text: String) {
+        guard start.isFinite, end.isFinite, end >= start else { return }
+        segments.removeAll { abs($0.start - start) < 0.001 || ($0.start < end && $0.end > start) }
+        let text = String(text.prefix(10_000)).trimmingCharacters(in: .whitespacesAndNewlines)
+        if !text.isEmpty { segments.append(.init(start: start, end: end, text: text)) }
+        segments.sort { $0.start < $1.start }
+        if segments.count > 128 { segments.removeFirst(segments.count - 128) }
+    }
+    public var text: String { String(segments.map(\.text).joined(separator: " ").prefix(10_000)) }
+}
+
+public enum VoiceSpokenText {
+    /// Keep long code, tables and links on screen instead of reading their syntax aloud.
+    public static func prepare(_ text: String, russian: Bool) -> String {
+        var inCode = false
+        let lines = text.components(separatedBy: .newlines).compactMap { line -> String? in
+            if line.trimmingCharacters(in: .whitespaces).hasPrefix("```") { inCode.toggle(); return nil }
+            guard !inCode, !line.trimmingCharacters(in: .whitespaces).hasPrefix("|") else { return nil }
+            return line
+        }
+        var value = lines.joined(separator: " ")
+        value = value.replacingOccurrences(of: #"\[([^\]]+)\]\([^\)]+\)"#, with: "$1", options: .regularExpression)
+        value = value.replacingOccurrences(of: #"https?://\S+"#, with: "", options: .regularExpression)
+        value = value.replacingOccurrences(of: #"[*#`_>]"#, with: "", options: .regularExpression)
+        value = value.replacingOccurrences(of: #"\s+"#, with: " ", options: .regularExpression).trimmingCharacters(in: .whitespacesAndNewlines)
+        if value.isEmpty { return russian ? "Результат показан в чате." : "The result is shown in the chat." }
+        if value.count > 1800 {
+            value = String(value.prefix(1600))
+            if let last = value.lastIndex(where: { ".!?".contains($0) }) { value = String(value[...last]) }
+            value += russian ? " Полный ответ — в чате." : " The full reply is in the chat."
+        }
+        return value
+    }
+}
diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/AppleVoiceInput.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/AppleVoiceInput.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/AppleVoiceInput.swift
@@ -0,0 +1,122 @@
+import AVFoundation
+import Foundation
+import Speech
+
+@MainActor public final class AppleVoiceInput: VoiceRecognizing {
+    private enum Kind { case speech, dictation }
+    private var kind: Kind?
+    private var locale = Locale(identifier: "ru-RU")
+    private var engine: AVAudioEngine?
+    private var capture: VoiceAudioCapture?
+    private var analyzer: SpeechAnalyzer?
+    private var results: Task<Void, Error>?
+    private var transcript = VoiceTranscript()
+    public init() {}
+    public func prepare(locale: Locale) async throws {
+        self.locale = locale
+        if SpeechTranscriber.isAvailable, let supported = await SpeechTranscriber.supportedLocale(equivalentTo: locale) {
+            kind = .speech; self.locale = supported
+        } else if let supported = await DictationTranscriber.supportedLocale(equivalentTo: locale) {
+            kind = .dictation; self.locale = supported
+        } else { throw VoiceFailure.languageUnavailable }
+        let module = try module()
+        if let request = try await AssetInventory.assetInstallationRequest(supporting: [module]) { try await request.downloadAndInstall() }
+        try Task.checkCancellation()
+        let allowed: Bool
+        switch AVCaptureDevice.authorizationStatus(for: .audio) {
+        case .authorized: allowed = true
+        case .notDetermined: allowed = await AVCaptureDevice.requestAccess(for: .audio)
+        default: allowed = false
+        }
+        guard allowed else { throw VoiceFailure.microphoneDenied }
+    }
+    private func module() throws -> any SpeechModule {
+        switch kind {
+        case .speech: SpeechTranscriber(locale: locale, preset: .progressiveTranscription)
+        case .dictation: DictationTranscriber(locale: locale, preset: .progressiveLongDictation)
+        case nil: throw VoiceFailure.languageUnavailable
+        }
+    }
+    public func start(update: @escaping @MainActor (String) -> Void, activity: @escaping @MainActor () -> Void,
+                      failure: @escaping @MainActor (Error) -> Void) async throws {
+        await stop()
+        try Task.checkCancellation()
+        try Self.activateAudio()
+        let module = try module()
+        guard let format = await SpeechAnalyzer.bestAvailableAudioFormat(compatibleWith: [module]) else { throw VoiceFailure.audioUnavailable }
+        let analyzer = SpeechAnalyzer(modules: [module]); self.analyzer = analyzer
+        transcript = VoiceTranscript()
+        if let speech = module as? SpeechTranscriber {
+            results = Task { [weak self] in
+                do {
+                    for try await result in speech.results {
+                        try Task.checkCancellation()
+                        self?.accept(String(result.text.characters), start: result.range.start.seconds, end: result.range.end.seconds, update: update)
+                    }
+                } catch { if !Task.isCancelled { failure(error) }; throw error }
+            }
+        } else if let dictation = module as? DictationTranscriber {
+            results = Task { [weak self] in
+                do {
+                    for try await result in dictation.results {
+                        try Task.checkCancellation()
+                        self?.accept(String(result.text.characters), start: result.range.start.seconds, end: result.range.end.seconds, update: update)
+                    }
+                } catch { if !Task.isCancelled { failure(error) }; throw error }
+            }
+        }
+        do {
+            let stream = AsyncThrowingStream<AnalyzerInput, Error>.makeStream(bufferingPolicy: .bufferingNewest(16))
+            let engine = AVAudioEngine(); self.engine = engine
+            let input = engine.inputNode
+            let natural = input.outputFormat(forBus: 0)
+            guard natural.sampleRate > 0, natural.channelCount > 0 else { throw VoiceFailure.audioUnavailable }
+            let capture = try VoiceAudioCapture(source: natural, destination: format, continuation: stream.continuation,
+                activity: { Task { @MainActor in activity() } })
+            self.capture = capture
+            input.installTap(onBus: 0, bufferSize: 2048, format: natural, block: capture.tapBlock())
+            try await analyzer.prepareToAnalyze(in: format)
+            try await analyzer.start(inputSequence: stream.stream)
+            try Task.checkCancellation()
+            engine.prepare(); try engine.start()
+        } catch { await stop(); throw error }
+    }
+    private func accept(_ text: String, start: Double, end: Double, update: (String) -> Void) {
+        transcript.replace(start: start, end: end, text: text); update(transcript.text)
+    }
+    private func stopCapture() {
+        if let engine { engine.stop(); engine.inputNode.removeTap(onBus: 0) }
+        engine = nil; capture?.finish(); capture = nil
+    }
+    public func finish() async throws -> String {
+        stopCapture()
+        guard let analyzer else { return transcript.text }
+        do {
+            try await withThrowingTaskGroup(of: Void.self) { group in
+                group.addTask { try await analyzer.finalizeAndFinishThroughEndOfInput() }
+                group.addTask { try await Task.sleep(for: .seconds(4)); await analyzer.cancelAndFinishNow(); throw VoiceFailure.interrupted }
+                _ = try await group.next(); group.cancelAll()
+            }
+            try await results?.value
+            self.analyzer = nil; results = nil
+            return transcript.text
+        } catch { await stop(); throw error }
+    }
+    public func stop() async {
+        stopCapture()
+        results?.cancel(); let old = analyzer; analyzer = nil
+        await old?.cancelAndFinishNow()
+        if let results { _ = try? await results.value }
+        results = nil
+        #if os(iOS)
+        try? AVAudioSession.sharedInstance().setActive(false, options: .notifyOthersOnDeactivation)
+        #endif
+    }
+    static func activateAudio() throws {
+        #if os(iOS)
+        let session = AVAudioSession.sharedInstance()
+        try session.setCategory(.playAndRecord, mode: .voiceChat, options: [.defaultToSpeaker, .allowBluetoothHFP])
+        try session.setActive(true)
+        #endif
+    }
+}
diff --git a/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/AppleVoiceOutput.swift b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/AppleVoiceOutput.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotAppleIntegrations/Sources/BlotAppleIntegrations/AppleVoiceOutput.swift
@@ -0,0 +1,54 @@
+import AVFoundation
+import Foundation
+
+@MainActor public final class AppleVoiceOutput: NSObject, VoiceSpeaking, AVSpeechSynthesizerDelegate {
+    private let synthesizer = AVSpeechSynthesizer()
+    private var voice: AVSpeechSynthesisVoice?
+    private var completion: CheckedContinuation<Void, Error>?
+    private var utterance: AVSpeechUtterance?
+    private var watchdog: Task<Void, Never>?
+    public override init() { super.init(); synthesizer.delegate = self }
+    public func prepare(locale: Locale) throws {
+        voice = AVSpeechSynthesisVoice(language: locale.identifier.replacingOccurrences(of: "_", with: "-"))
+        guard voice != nil else { throw VoiceFailure.voiceUnavailable }
+    }
+    public func speak(_ text: String) async throws {
+        try Task.checkCancellation()
+        guard let voice else { throw VoiceFailure.voiceUnavailable }
+        stop()
+        try AppleVoiceInput.activateAudio()
+        let item = AVSpeechUtterance(string: text); item.voice = voice
+        item.rate = AVSpeechUtteranceDefaultSpeechRate
+        try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                utterance = item; completion = continuation; synthesizer.speak(item)
+                watchdog = Task { [weak self] in
+                    do { try await Task.sleep(for: .seconds(15 + Double(text.count) / 4)) } catch { return }
+                    guard let self, self.utterance === item else { return }
+                    self.utterance = nil; let reply = self.completion; self.completion = nil
+                    self.synthesizer.stopSpeaking(at: .immediate); reply?.resume(throwing: VoiceFailure.audioUnavailable)
+                }
+            }
+        } onCancel: { Task { @MainActor [weak self] in self?.stop() } }
+    }
+    public func stop() {
+        watchdog?.cancel(); watchdog = nil
+        utterance = nil
+        let reply = completion; completion = nil
+        synthesizer.stopSpeaking(at: .immediate)
+        reply?.resume(throwing: CancellationError())
+    }
+    nonisolated public func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer, didFinish utterance: AVSpeechUtterance) {
+        let id = ObjectIdentifier(utterance)
+        Task { @MainActor [weak self] in self?.finished(id) }
+    }
+    nonisolated public func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer, didCancel utterance: AVSpeechUtterance) {
+        let id = ObjectIdentifier(utterance)
+        Task { @MainActor [weak self] in self?.finished(id) }
+    }
+    private func finished(_ id: ObjectIdentifier) {
+        guard utterance.map(ObjectIdentifier.init) == id else { return }
+        watchdog?.cancel(); watchdog = nil
+        utterance = nil; let reply = completion; completion = nil; reply?.resume()
+    }
+}
