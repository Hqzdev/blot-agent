diff --git a/apps/ios/BlotIOS/Features/Shared/PhonePageLayout.swift b/apps/ios/BlotIOS/Features/Shared/PhonePageLayout.swift
new file mode 100644
--- /dev/null
+++ b/apps/ios/BlotIOS/Features/Shared/PhonePageLayout.swift
@@ -0,0 +1,57 @@
+import BlotDesign
+import SwiftUI
+
+enum PhonePageLayout {
+    static let inset: CGFloat = 20
+    static let sectionSpacing: CGFloat = 24
+    static let rowInset: CGFloat = 16
+    static let radius: CGFloat = 16
+}
+
+extension EnvironmentValues {
+    @Entry var phonePageTitle: String? = nil
+}
+
+struct PhonePageHeader<Actions: View>: View {
+    let title: String
+    var back: (() -> Void)? = nil
+    @ViewBuilder var actions: Actions
+    @Environment(WorkspaceStore.self) private var store
+
+    var body: some View {
+        HStack(spacing: 12) {
+            if let back {
+                PhoneGlassCircleButton(symbol: "chevron.left", title: store.t("Back"), action: back)
+            }
+            Text(title).font(.title2.weight(.semibold)).lineLimit(1).truncationMode(.tail)
+                .accessibilityAddTraits(.isHeader)
+                .frame(maxWidth: .infinity, alignment: .leading)
+            actions
+        }
+        .frame(minHeight: 44)
+        .padding(.horizontal, PhonePageLayout.inset).padding(.vertical, 8)
+        .background(WorkspaceStyle.canvas)
+    }
+}
+
+extension PhonePageHeader where Actions == EmptyView {
+    init(title: String, back: (() -> Void)? = nil) {
+        self.title = title
+        self.back = back
+        self.actions = EmptyView()
+    }
+}
+
+struct PhonePage<Content: View>: View {
+    @ViewBuilder var content: Content
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: PhonePageLayout.sectionSpacing) { content }
+                .frame(maxWidth: 640, alignment: .leading)
+                .padding(PhonePageLayout.inset).frame(maxWidth: .infinity)
+        }
+        .scrollDismissesKeyboard(.interactively)
+        .background(WorkspaceStyle.canvas.ignoresSafeArea())
+    }
+}
diff --git a/apps/ios/BlotIOS/Features/Shared/PhonePageSearchField.swift b/apps/ios/BlotIOS/Features/Shared/PhonePageSearchField.swift
new file mode 100644
--- /dev/null
+++ b/apps/ios/BlotIOS/Features/Shared/PhonePageSearchField.swift
@@ -0,0 +1,26 @@
+import BlotDesign
+import SwiftUI
+
+struct PhonePageSearchField: View {
+    let placeholder: String
+    @Binding var text: String
+    @Environment(WorkspaceStore.self) private var store
+
+    var body: some View {
+        HStack(spacing: 10) {
+            BlotIcon(.search, size: 18).foregroundStyle(WorkspaceStyle.secondary)
+            TextField(placeholder, text: $text).font(.subheadline).textFieldStyle(.plain)
+                .autocorrectionDisabled().textInputAutocapitalization(.never)
+                .submitLabel(.search).accessibilityLabel(placeholder)
+            if !text.isEmpty {
+                Button { text = "" } label: {
+                    BlotIcon(symbol: "xmark.circle.fill", size: 18)
+                        .frame(width: 44, height: 44).foregroundStyle(WorkspaceStyle.secondary)
+                }.buttonStyle(.plain).accessibilityLabel(store.t("Clear search"))
+            }
+        }
+        .padding(.leading, 16).padding(.trailing, text.isEmpty ? 16 : 2).frame(minHeight: 48)
+        .background(PhoneSettingsStyle.row, in: RoundedRectangle(cornerRadius: PhonePageLayout.radius))
+        .overlay(RoundedRectangle(cornerRadius: PhonePageLayout.radius).strokeBorder(PhoneSettingsStyle.edge))
+    }
+}
