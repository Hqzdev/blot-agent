diff --git a/apps/verification/WorkspacePresentationTests/PhoneAgentDefaultsTests.swift b/apps/verification/WorkspacePresentationTests/PhoneAgentDefaultsTests.swift
new file mode 100644
--- /dev/null
+++ b/apps/verification/WorkspacePresentationTests/PhoneAgentDefaultsTests.swift
@@ -0,0 +1,29 @@
+import Foundation
+import XCTest
+
+@MainActor
+final class PhoneAgentDefaultsTests: XCTestCase {
+    func testAgentSavesBuiltInToolsAndKeepsConnectedAppTools() async throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        let service = try LocalWorkspaceService(databaseURL: directory.appendingPathComponent("workspace.sqlite"))
+        let store = WorkspaceStore(mode: .live, service: service)
+        await store.loadWorkspace()
+        store.beginAgentCreation()
+        store.form.agent.name = "Researcher"
+        store.form.agent.instructions = "Prepare reports"
+        store.form.agent.toolIDs = ["apple_calendar_read"]
+        await store.perform(.createAgent)
+        XCTAssertNil(store.error)
+        let agentID = try XCTUnwrap(store.selectedAgentID)
+        let revision = try XCTUnwrap(store.snapshot.configurations?.first { $0.agentId == agentID })
+        XCTAssertEqual(Set(revision.toolIds), ["file_read", "document_create", "memory_candidate", "apple_calendar_read"])
+        store.selectAgent(agentID, destination: .editAgent)
+        store.form.agent.name = "Updated researcher"
+        await store.perform(.saveAgent)
+        XCTAssertNil(store.error)
+        let updated = try XCTUnwrap(store.snapshot.configurations?.filter { $0.agentId == agentID }.max { $0.revision < $1.revision })
+        XCTAssertEqual(Set(updated.toolIds), Set(revision.toolIds))
+        try await service.close()
+        try FileManager.default.removeItem(at: directory)
+    }
+}
diff --git a/apps/verification/WorkspacePresentationTests/PhoneOverviewContentTests.swift b/apps/verification/WorkspacePresentationTests/PhoneOverviewContentTests.swift
new file mode 100644
--- /dev/null
+++ b/apps/verification/WorkspacePresentationTests/PhoneOverviewContentTests.swift
@@ -0,0 +1,47 @@
+import BlotDomain
+import Foundation
+import XCTest
+
+@MainActor
+final class PhoneOverviewContentTests: XCTestCase {
+    func testWorkFromDifferentChatsAppearsAndCanceledWorkStaysOut() throws {
+        let tasks = try BlotV3.TaskState.allCases.map { state in
+            let id = UUID()
+            return try BlotV3.Task(metadata: metadata(id: id),
+                execution: .init(executorDeviceId: UUID(), originDeviceId: UUID(), taskId: id, revision: 1),
+                conversationId: UUID(), goal: state.rawValue, state: state, plan: [])
+        }
+        var snapshot = WorkspaceSnapshot()
+        snapshot.tasks = tasks
+        let content = PhoneOverviewContent(snapshot: snapshot, now: .now)
+        XCTAssertEqual(Set(content.attention.map(\.state)), [.waiting_approval, .waiting_user, .interrupted, .failed])
+        XCTAssertEqual(Set(content.active.map(\.state)), [.draft, .planning, .queued, .running, .paused])
+        XCTAssertEqual(content.completed.map(\.state), [.completed])
+        XCTAssertEqual(Set((content.attention + content.active + content.completed).map(\.conversationId)).count, tasks.count - 1)
+    }
+
+    func testUpcomingRunsRespectTimeZonesAndSkipDisabledOrPastSchedules() throws {
+        let now = try XCTUnwrap(ISO8601DateFormatter().date(from: "2026-11-07T06:00:00Z"))
+        var snapshot = WorkspaceSnapshot()
+        snapshot.schedules = [
+            try schedule("Later", time: "12:00", timezone: "Asia/Yekaterinburg"),
+            try schedule("Sooner", time: "09:30", timezone: "Europe/Moscow"),
+            try schedule("Disabled", time: "11:15", timezone: "Asia/Yekaterinburg", enabled: false),
+            try schedule("Past", time: "11:00", timezone: "Asia/Yekaterinburg", scheduledAt: now.addingTimeInterval(-60))
+        ]
+        let content = PhoneOverviewContent(snapshot: snapshot, now: now)
+        XCTAssertEqual(content.upcoming.map(\.schedule.name), ["Sooner", "Later"])
+        XCTAssertEqual(content.upcoming.map { $0.date.timeIntervalSince(now) }, [1800, 3600])
+    }
+
+    private func metadata(id: UUID = UUID()) throws -> BlotV3.RecordMetadata {
+        try .init(id: id, ownerId: UUID(), version: 1, createdAt: .now, updatedAt: .now)
+    }
+
+    private func schedule(_ name: String, time: String, timezone: String, enabled: Bool = true,
+                          scheduledAt: Date? = nil) throws -> BlotV3.Automation {
+        try .init(metadata: metadata(), kind: .task, name: name, goal: "Prepare report", timezone: timezone,
+                  localTime: time, weekdays: [1, 2, 3, 4, 5, 6, 7], missedRunPolicy: .coalesce,
+                  enabled: enabled, scheduledAt: scheduledAt)
+    }
+}
diff --git a/apps/verification/WorkspacePresentationTests/PhonePageRenderingTests.swift b/apps/verification/WorkspacePresentationTests/PhonePageRenderingTests.swift
new file mode 100644
--- /dev/null
+++ b/apps/verification/WorkspacePresentationTests/PhonePageRenderingTests.swift
@@ -0,0 +1,38 @@
+import SwiftUI
+import UIKit
+import XCTest
+
+@MainActor
+final class PhonePageRenderingTests: XCTestCase {
+    func testRenderWorkspacePagesOnPhysicalDevice() async throws {
+        let scene = try XCTUnwrap(UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }.first)
+        let previous = scene.windows.first(where: \.isKeyWindow)
+        let window = UIWindow(windowScene: scene)
+        defer { window.isHidden = true; window.rootViewController = nil; previous?.makeKeyAndVisible() }
+        let samples: [(WorkspaceRoute, Bool, Int)] = [
+            (.overview, false, 0), (.schedules, false, 0), (.settings, false, 0),
+            (.settingsProfile, false, 0), (.files, false, 0), (.createSchedule, false, 0),
+            (.createAgent, false, 0), (.schedules, false, 1), (.overview, true, 0)
+        ]
+        for (route, accessibility, dayOffset) in samples {
+            let store = WorkspaceStore(mode: .preview, route: route)
+            store.language = "ru"
+            store.navigation.scheduleDate = Calendar.current.date(byAdding: .day, value: dayOffset, to: .now) ?? .now
+            let host = UIHostingController(rootView: WorkspaceRootView(store: store)
+                .preferredColorScheme(accessibility ? .dark : .light)
+                .environment(\.dynamicTypeSize, accessibility ? .accessibility1 : .large))
+            window.rootViewController = host
+            window.makeKeyAndVisible()
+            try await _Concurrency.Task.sleep(for: .milliseconds(350))
+            host.view.layoutIfNeeded()
+            XCTAssertFalse(host.view.bounds.isEmpty)
+            let image = UIGraphicsImageRenderer(bounds: window.bounds).image { _ in
+                window.drawHierarchy(in: window.bounds, afterScreenUpdates: true)
+            }
+            let attachment = XCTAttachment(image: image)
+            attachment.name = "iPhone-\(route.rawValue)-\(dayOffset)" + (accessibility ? "-large-dark" : "")
+            attachment.lifetime = .keepAlways
+            add(attachment)
+        }
+    }
+}
