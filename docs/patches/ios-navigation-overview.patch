new file mode 100644
--- /dev/null
+++ b/apps/ios/BlotIOS/Features/Schedules/PhoneScheduleCalendar.swift
@@ -0,0 +1,59 @@
+import BlotDesign
+import SwiftUI
+
+struct PhoneScheduleCalendar: View {
+    @Binding var selectedDate: Date
+    let calendar: Calendar
+    @Environment(WorkspaceStore.self) private var store
+    @ScaledMetric(relativeTo: .body) private var dayHeight: CGFloat = 72
+
+    private var days: [Date] {
+        guard let week = calendar.dateInterval(of: .weekOfYear, for: selectedDate) else { return [] }
+        return (0..<7).compactMap { calendar.date(byAdding: .day, value: $0, to: week.start) }
+    }
+
+    var body: some View {
+        VStack(spacing: 12) {
+            HStack {
+                weekButton("chevron.left", title: "Previous week", offset: -1)
+                DatePicker(store.t("Date"), selection: $selectedDate, displayedComponents: .date)
+                    .labelsHidden().datePickerStyle(.compact).frame(maxWidth: .infinity)
+                weekButton("chevron.right", title: "Next week", offset: 1)
+            }
+            GeometryReader { geometry in
+                ScrollView(.horizontal) {
+                    HStack(spacing: 4) {
+                        ForEach(days, id: \.self) { date in day(date) }
+                    }.frame(minWidth: geometry.size.width)
+                }.scrollIndicators(.hidden)
+            }.frame(height: dayHeight)
+        }
+    }
+
+    private func day(_ date: Date) -> some View {
+        let selected = calendar.isDate(date, inSameDayAs: selectedDate)
+        return Button { selectedDate = date } label: {
+            VStack(spacing: 8) {
+                Text(date, format: .dateTime.weekday(.narrow)).font(.caption)
+                Text(date, format: .dateTime.day()).font(.body.weight(.medium))
+                Circle().fill(calendar.isDateInToday(date) ? (selected ? BlotColor.onInverse : WorkspaceStyle.ink) : .clear)
+                    .frame(width: 4, height: 4)
+            }
+            .frame(minWidth: 44, maxWidth: .infinity, minHeight: dayHeight)
+            .foregroundStyle(selected ? BlotColor.onInverse : WorkspaceStyle.ink)
+            .background(selected ? BlotColor.inverse : PhoneSettingsStyle.row,
+                        in: RoundedRectangle(cornerRadius: PhonePageLayout.radius))
+            .contentShape(Rectangle())
+        }.buttonStyle(.plain)
+            .accessibilityLabel(date.formatted(.dateTime.weekday(.wide).day().month().locale(calendar.locale ?? .current)))
+            .accessibilityAddTraits(selected ? .isSelected : [])
+            .accessibilityIdentifier("workspace.schedule.day.\(calendar.component(.weekday, from: date))")
+    }
+
+    private func weekButton(_ symbol: String, title: String, offset: Int) -> some View {
+        Button {
+            if let date = calendar.date(byAdding: .weekOfYear, value: offset, to: selectedDate) { selectedDate = date }
+        } label: { BlotIcon(symbol: symbol, size: 18).frame(width: 44, height: 44) }
+            .buttonStyle(.plain).accessibilityLabel(store.t(title))
+    }
+}
diff --git a/apps/ios/BlotIOS/Features/Schedules/PhoneScheduleDayContent.swift b/apps/ios/BlotIOS/Features/Schedules/PhoneScheduleDayContent.swift
new file mode 100644
--- /dev/null
+++ b/apps/ios/BlotIOS/Features/Schedules/PhoneScheduleDayContent.swift
@@ -0,0 +1,32 @@
+import BlotDomain
+import BlotWorkspace
+import Foundation
+
+struct PhoneScheduleDayContent {
+    struct Run: Identifiable {
+        let schedule: BlotV3.Automation
+        let date: Date
+        var id: UUID { schedule.metadata.id }
+    }
+
+    let runs: [Run]
+
+    init(schedules: [BlotV3.Automation], day: Date, calendar: Calendar) {
+        let start = calendar.startOfDay(for: day)
+        let end = calendar.date(byAdding: .day, value: 1, to: start) ?? start
+        let calculator = WorkspaceScheduleCalculator()
+        runs = schedules.compactMap { schedule in
+            // Paused schedules remain visible on their scheduled day.
+            let display = try? BlotV3.Automation(metadata: schedule.metadata, kind: schedule.kind,
+                executorDeviceId: schedule.executorDeviceId, agentId: schedule.agentId,
+                name: schedule.name, goal: schedule.goal, timezone: schedule.timezone,
+                localTime: schedule.localTime, weekdays: schedule.weekdays,
+                missedRunPolicy: schedule.missedRunPolicy, enabled: true,
+                skillRevisionId: schedule.skillRevisionId, scheduledAt: schedule.scheduledAt,
+                maxCatchUpRuns: schedule.maxCatchUpRuns)
+            guard let display, let date = try? calculator.nextRun(for: display, after: start.addingTimeInterval(-0.001)),
+                  date < end else { return nil }
+            return Run(schedule: schedule, date: date)
+        }.sorted { $0.date < $1.date }
+    }
+}
