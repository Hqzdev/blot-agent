+#if os(macOS)
+import CryptoKit
+import Foundation
+
+/// Scoped file operations are separate from the explicitly trusted, unrestricted command runner.
+public struct NativeProjectFiles: Sendable {
+    private let root: URL
+    public init(root: String) throws {
+        let url = URL(fileURLWithPath: root).standardizedFileURL.resolvingSymlinksInPath()
+        var directory: ObjCBool = false
+        guard root.hasPrefix("/"), FileManager.default.fileExists(atPath: url.path, isDirectory: &directory), directory.boolValue else { throw NativeExecutionError.accessDenied }
+        self.root = url
+    }
+    func url(_ path: String, directory: Bool = false) throws -> URL {
+        guard !path.hasPrefix("/"), !path.contains("\0"), path.utf8.count <= 4096 else { throw NativeExecutionError.accessDenied }
+        let candidate = root.appendingPathComponent(path).standardizedFileURL.resolvingSymlinksInPath()
+        guard candidate == root && directory || candidate.path.hasPrefix(root.path + "/"),
+              !candidate.pathComponents.dropFirst(root.pathComponents.count).contains(".git") else { throw NativeExecutionError.accessDenied }
+        if directory {
+            var isDirectory: ObjCBool = false
+            guard FileManager.default.fileExists(atPath: candidate.path, isDirectory: &isDirectory), isDirectory.boolValue else { throw NativeExecutionError.invalidRequest }
+        }
+        return candidate
+    }
+    public func read(_ path: String) throws -> ChatJSON {
+        let target = try url(path)
+        let attributes = try FileManager.default.attributesOfItem(atPath: target.path)
+        guard attributes[.type] as? FileAttributeType == .typeRegular, (attributes[.size] as? NSNumber)?.intValue ?? Int.max <= 1_048_576 else { throw NativeExecutionError.invalidRequest }
+        let data = try Data(contentsOf: target)
+        guard String(data: data, encoding: .utf8) != nil else { throw NativeExecutionError.invalidRequest }
+        return .object(["path": .string(path), "content": .string(String(decoding: data.prefix(48_000), as: UTF8.self)), "sha256": .string(Self.hash(data)), "truncated": .bool(data.count > 48_000)])
+    }
+    public func write(_ path: String, content: String, expectedHash: String) throws -> ChatJSON {
+        let target = try url(path)
+        guard content.utf8.count <= 48 * 1024 else { throw NativeExecutionError.invalidRequest }
+        var coordinationError: NSError?, failure: Error?
+        NSFileCoordinator().coordinate(writingItemAt: target, options: .forReplacing, error: &coordinationError) { coordinated in
+            do {
+                let old: Data?
+                var permissions: NSNumber?
+                if FileManager.default.fileExists(atPath: coordinated.path) {
+                    let attributes = try FileManager.default.attributesOfItem(atPath: coordinated.path)
+                    let size = (attributes[.size] as? NSNumber)?.intValue ?? Int.max
+                    permissions = attributes[.posixPermissions] as? NSNumber
+                    guard size <= 1_048_576 else { throw NativeExecutionError.invalidRequest }
+                    old = try Data(contentsOf: coordinated)
+                } else { old = nil }
+                guard (old.map(Self.hash) ?? "missing") == expectedHash, try url(path) == target else { throw NativeExecutionError.changed }
+                try Data(content.utf8).write(to: coordinated, options: .atomic)
+                if let permissions { try FileManager.default.setAttributes([.posixPermissions: permissions], ofItemAtPath: coordinated.path) }
+            } catch { failure = error }
+        }
+        if let coordinationError { throw coordinationError }; if let failure { throw failure }
+        return .object(["path": .string(path), "sha256": .string(Self.hash(Data(content.utf8))), "state": .string("succeeded")])
+    }
+    public func search(_ query: String) throws -> ChatJSON {
+        guard !query.isEmpty, query.utf8.count <= 1000 else { throw NativeExecutionError.invalidRequest }
+        let excluded: Set<String> = [".git", ".build", "node_modules", ".gradle", "DerivedData"]
+        guard let iterator = FileManager.default.enumerator(at: root, includingPropertiesForKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey], options: [.skipsHiddenFiles]) else { throw NativeExecutionError.unavailable }
+        var results: [ChatJSON] = [], inspected = 0
+        for case let file as URL in iterator {
+            inspected += 1
+            if inspected > 10_000 || results.count >= 100 { break }
+            if excluded.contains(file.lastPathComponent) { iterator.skipDescendants(); continue }
+            let values = try file.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey])
+            if values.isSymbolicLink == true { iterator.skipDescendants(); continue }
+            guard values.isRegularFile == true, (values.fileSize ?? Int.max) <= 256 * 1024,
+                  let text = try? String(contentsOf: file, encoding: .utf8) else { continue }
+            let relative = String(file.path.dropFirst(root.path.count + 1))
+            for (line, value) in text.components(separatedBy: .newlines).enumerated() where value.contains(query) {
+                results.append(.object(["path": .string(relative), "line": .number(Double(line + 1)), "text": .string(String(value.prefix(500)))]))
+                if results.count >= 100 { break }
+            }
+        }
+        return .object(["matches": .array(results), "truncated": .bool(inspected > 10_000 || results.count >= 100)])
+    }
+    static func hash(_ data: Data) -> String { SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined() }
+}
+#endif
diff --git a/packages/BlotWorkspace/Sources/BlotWorkspace/NativeXPCClient.swift b/packages/BlotWorkspace/Sources/BlotWorkspace/NativeXPCClient.swift
new file mode 100644
--- /dev/null
+++ b/packages/BlotWorkspace/Sources/BlotWorkspace/NativeXPCClient.swift
@@ -0,0 +1,89 @@
+#if os(macOS)
+import Foundation
+import Security
+
+@objc public protocol NativeExecutorXPC {
+    func perform(_ data: Data, reply: @escaping (Data?, String?) -> Void)
+    func shutdown(reply: @escaping () -> Void)
+}
+
+public enum NativeCodeIdentity {
+    public static func requirement(at url: URL) throws -> String {
+        var code: SecStaticCode?, requirement: SecRequirement?, text: CFString?
+        guard SecStaticCodeCreateWithPath(url as CFURL, [], &code) == errSecSuccess, let code,
+              SecStaticCodeCheckValidity(code, SecCSFlags(rawValue: UInt32(kSecCSCheckAllArchitectures)), nil) == errSecSuccess,
+              SecCodeCopyDesignatedRequirement(code, [], &requirement) == errSecSuccess, let requirement,
+              SecRequirementCopyString(requirement, [], &text) == errSecSuccess, let text else { throw NativeExecutionError.unavailable }
+        return text as String
+    }
+}
+
+/// No public socket or legacy backend endpoint. The OS enforces the embedded helper's exact code requirement.
+public actor NativeXPCClient: NativeExecuting {
+    public static let identifier = "dev.blot.workspace-executor"
+    private var connection: NSXPCConnection?
+    private var pending: [UUID: CheckedContinuation<ChatJSON, Error>] = [:]
+    private var timers: [UUID: _Concurrency.Task<Void, Never>] = [:]
+    private var stopped = false
+    public init() {}
+    private func connect() throws -> NSXPCConnection {
+        guard !stopped else { throw NativeExecutionError.unavailable }
+        if let connection { return connection }
+        let service = Bundle.main.bundleURL.appendingPathComponent("Contents/XPCServices/BlotWorkspaceExecutor.xpc")
+        let requirement = try NativeCodeIdentity.requirement(at: service)
+        let connection = NSXPCConnection(serviceName: Self.identifier)
+        connection.remoteObjectInterface = NSXPCInterface(with: NativeExecutorXPC.self)
+        connection.setCodeSigningRequirement(requirement)
+        connection.interruptionHandler = { [weak self] in _Concurrency.Task { await self?.failed() } }
+        connection.invalidationHandler = { [weak self] in _Concurrency.Task { await self?.failed() } }
+        connection.resume(); self.connection = connection
+        return connection
+    }
+    public func request(_ request: NativeRequest) async throws -> ChatJSON {
+        let connection = try connect(), data = try WorkspaceCoding.encode(request), id = UUID()
+        return try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                pending[id] = continuation
+                let proxy = connection.remoteObjectProxyWithErrorHandler { [weak self] _ in _Concurrency.Task { await self?.finish(id, data: nil, error: "unavailable") } }
+                guard let executor = proxy as? NativeExecutorXPC else { finish(id, data: nil, error: "unavailable"); return }
+                executor.perform(data) { [weak self] data, error in _Concurrency.Task { await self?.finish(id, data: data, error: error) } }
+                timers[id] = _Concurrency.Task { [weak self] in
+                    do { try await _Concurrency.Task.sleep(for: .seconds(130)); await self?.expire(id) } catch {}
+                }
+            }
+        } onCancel: { _Concurrency.Task { await self.expire(id) } }
+    }
+    private func finish(_ id: UUID, data: Data?, error: String?) {
+        guard let continuation = pending.removeValue(forKey: id) else { return }
+        timers.removeValue(forKey: id)?.cancel()
+        if let data, data.count <= 8 * 1024 * 1024, let result = try? JSONDecoder().decode(ChatJSON.self, from: data) { continuation.resume(returning: result) }
+        else { continuation.resume(throwing: NativeExecutionError.remote(error ?? "unavailable")) }
+    }
+    private func expire(_ id: UUID) { timers.removeValue(forKey: id)?.cancel(); pending.removeValue(forKey: id)?.resume(throwing: NativeExecutionError.unknown) }
+    private func failed() {
+        connection = nil
+        for timer in timers.values { timer.cancel() }; timers = [:]
+        let continuations = pending.values; pending.removeAll()
+        for continuation in continuations { continuation.resume(throwing: NativeExecutionError.unknown) }
+    }
+    public func stopAll() async {
+        stopped = true
+        if let connection, let proxy = connection.remoteObjectProxy as? NativeExecutorXPC {
+            await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+                let once = NativeShutdownReply(continuation)
+                proxy.shutdown { once.finish() }
+                _Concurrency.Task { try? await _Concurrency.Task.sleep(for: .seconds(4)); once.finish() }
+            }
+            connection.invalidate()
+        }
+        connection = nil; failed()
+    }
+}
+
+private final class NativeShutdownReply: @unchecked Sendable {
+    private let lock = NSLock()
+    private var continuation: CheckedContinuation<Void, Never>?
+    init(_ continuation: CheckedContinuation<Void, Never>) { self.continuation = continuation }
+    func finish() { lock.lock(); let value = continuation; continuation = nil; lock.unlock(); value?.resume() }
+}
+#endif
