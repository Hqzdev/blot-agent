+            guard trustedLocalProcess, endpoint.hasPrefix("/"), workingDirectory.hasPrefix("/"),
+                  !endpoint.contains("\0"), !workingDirectory.contains("\0"), bearerToken.isEmpty else { throw MCPError.configuration }
+            #else
