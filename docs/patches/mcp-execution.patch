+        let digest = SHA256.hash(data: data).prefix(8).map { String(format: "%02x", $0) }.joined()
+        return "mcp_" + connectionID.uuidString.replacingOccurrences(of: "-", with: "").prefix(16) + "_" + configurationID.uuidString.prefix(8) + "_" + digest
+    }
+}
